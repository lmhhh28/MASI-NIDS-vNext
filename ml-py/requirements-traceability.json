    {"requirement_id": "CONTRACT-MODEL-001", "scenario_ids": ["TEST-ML-BUNDLE-001"], "command_ids": ["release-blackbox", "central-consumer-build", "central-consumer", "triton-smoke"], "qualification_limit": "immutable CPU repository and external manifest digests; Go current binding remains out of module scope"},
