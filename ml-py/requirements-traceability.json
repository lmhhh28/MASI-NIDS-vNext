    {"requirement_id": "SEC-004", "scenario_ids": ["TEST-ML-ARTIFACT-INTEGRITY-001"], "command_ids": ["unit-contract", "release-blackbox", "central-consumer", "fault"], "qualification_limit": "ordinary no-symlink read-only bounded model repository and safe archive"},
    {"requirement_id": "SEC-005", "scenario_ids": ["TEST-ML-INPUT-CLEANUP-001"], "command_ids": ["source-sentinels", "fault", "formal-soak"], "qualification_limit": "strict paths, atomic output, exact-owned staging cleanup and bounded diagnostics"},
    {"requirement_id": "SEC-SUPPLY-001", "scenario_ids": ["TEST-ML-SUPPLY-001"], "command_ids": ["image-build", "supply-chain"], "qualification_limit": "offline scanners and current databases; protected release provenance remains qualification-only HOLD"},
    {"requirement_id": "DEP-004", "scenario_ids": ["TEST-ML-OCI-001"], "command_ids": ["image-build", "oci-smoke", "deployment-policy"], "qualification_limit": "non-root, read-only, network-none bounded offline OCI job"},
    {"requirement_id": "PERF-001", "scenario_ids": ["TEST-ML-PERFORMANCE-001"], "command_ids": ["performance", "formal-soak"], "qualification_limit": "frozen deterministic module dataset and single-host CPU execution environment"},
    {"requirement_id": "PERF-002", "scenario_ids": ["TEST-ML-PERFORMANCE-001"], "command_ids": ["performance", "formal-soak"], "qualification_limit": "complete-pipeline throughput/latency/RSS/FD/output/error/resource-trend evidence"},
    {"requirement_id": "TEST-002", "scenario_ids": ["TEST-ML-LANGUAGE-001"], "command_ids": ["format", "lint", "typecheck", "unit-contract", "contract-schema"], "qualification_limit": "Python 3.12 lint/type/unittest/contract/golden/fault with no pytest"},
    {"requirement_id": "TEST-003", "scenario_ids": ["TEST-ML-BLACKBOX-001"], "command_ids": ["release-build", "release-blackbox", "central-consumer", "triton-smoke", "oci-smoke"], "qualification_limit": "actual installed release and OCI execute training/export/package through real CPU consumers"},
