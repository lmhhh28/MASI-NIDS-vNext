  "requirements": [
    {"requirement_id": "MOD-ML-001", "scenario_ids": ["TEST-ML-MODULE-GATES-001"], "command_ids": ["contract-schema", "release-blackbox", "central-consumer", "triton-smoke", "fault", "performance", "oci-smoke", "supply-chain", "formal-soak"], "qualification_limit": "independent Offline ML operational completion on the deterministic module corpus and CPU bundle; production data quality and rollout remain separate"},
