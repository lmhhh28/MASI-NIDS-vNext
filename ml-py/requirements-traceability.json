    {"requirement_id": "TEST-007", "scenario_ids": ["TEST-ML-FAULT-001"], "command_ids": ["unit-contract", "fault", "formal-soak"], "qualification_limit": "archive/tamper/path/crash/cancel/partial-publication/stale-staging recovery"},
    {"requirement_id": "TEST-008", "scenario_ids": ["TEST-ML-SOAK-3600S-001"], "command_ids": ["performance", "formal-soak"], "qualification_limit": "60-second uncounted warmup and four monotonic 900-second phases"},
    {"requirement_id": "TEST-009", "scenario_ids": ["TEST-ML-EVIDENCE-001"], "command_ids": ["findings", "traceability", "supply-chain"], "qualification_limit": "schema-validated digest-bound current-source evidence and machine-derived completion"},
    {"requirement_id": "TEST-010", "scenario_ids": ["TEST-ML-MODULE-GATES-001"], "command_ids": ["contract-schema", "format", "lint", "typecheck", "unit-contract", "release-blackbox", "central-consumer", "triton-smoke", "fault", "performance", "oci-smoke", "supply-chain", "formal-soak", "findings"], "qualification_limit": "Offline ML Definition of Done with no operational blocker and open P0 zero"},
    {"requirement_id": "TEST-GATE-001", "scenario_ids": ["TEST-ML-MODULE-GATES-001"], "command_ids": ["release-blackbox", "central-consumer", "triton-smoke", "performance", "oci-smoke", "supply-chain", "formal-soak", "traceability"], "qualification_limit": "digest-bound ninth-module operational completion; nine-module global gate remains HOLD while Web is incomplete"},
    {"requirement_id": "TEST-REAL-E2E-001", "scenario_ids": ["TEST-ML-REAL-RUNTIME-001"], "command_ids": ["release-blackbox", "central-consumer", "triton-smoke", "oci-smoke"], "qualification_limit": "real Offline ML release/OCI/C++ consumer/Triton; formal pairwise/system rollout remains NOT_RUN"},
