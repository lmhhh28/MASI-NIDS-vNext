    {"requirement_id": "ACCEPT-001", "scenario_ids": ["TEST-ML-ACCEPTANCE-001"], "command_ids": ["release-blackbox", "central-consumer", "triton-smoke", "fault", "performance", "oci-smoke", "supply-chain", "formal-soak"], "qualification_limit": "Offline ML portion only; complete vNext acceptance remains global"}
