{
  "schema_version": "offline-ml-requirement-manifest/v1",
  "module_id": "MOD-ML-001",
  "owner_role": "Offline ML Artifact Pipeline module owner",
  "design_anchor": "docs/masi-nids-vnext-system-requirements-2026-08-09.md#48-offline-ml",
  "commands": {
    "stable": "scripts/run-module-gates.sh",
    "contracts": "python scripts/validate-static-contracts.py",
    "language": "ruff format --check && ruff check && pyright && python -m unittest",
    "blackbox": "python scripts/run-release-blackbox.py --entrypoint RELEASE_ENTRYPOINT",
    "central_consumer": "python scripts/run-central-consumer.py --validator CXX_VALIDATOR",
    "triton": "python scripts/run-triton-smoke.py --pipeline-output CANDIDATE_OUTPUT",
    "fault": "python scripts/run-faults.py --entrypoint RELEASE_ENTRYPOINT",
    "performance": "python scripts/run-performance.py --entrypoint RELEASE_ENTRYPOINT",
    "oci": "python scripts/run-oci-smoke.py --image masi-offline-ml:module-gates",
    "supply_chain": "scripts/run-supply-chain.sh",
    "formal_soak": "python scripts/run-soak.py --mode formal"
  },
  "execution_bindings": [
    {"command_id": "contract-schema", "required": true, "targets": ["dataset-p4-window-binary-v1", "model-explanation-evidence-v1", "evidence-schemas", "golden-negatives"]},
    {"command_id": "source-sentinels", "required": true, "targets": ["no-core-DB-P4-effect", "no-runtime-download", "no-pytest", "no-custom-executable"]},
    {"command_id": "findings", "required": true, "targets": ["append-only-findings", "open-P0-zero"]},
    {"command_id": "format", "required": true, "targets": ["ruff-format"]},
    {"command_id": "lint", "required": true, "targets": ["ruff"]},
    {"command_id": "typecheck", "required": true, "targets": ["pyright-strict-zero-errors"]},
    {"command_id": "unit-contract", "required": true, "targets": ["unittest", "dataset", "three-candidates-three-seeds", "explanations", "atomic-publication"]},
    {"command_id": "release-build", "required": true, "targets": ["CPython-3.12.13", "reproducible-wheel", "locked-offline-venv"]},
    {"command_id": "release-blackbox", "required": true, "targets": ["real-release-process", "two-complete-pipelines", "immutable-repository", "all-nine-candidates"]},
    {"command_id": "central-consumer-build", "required": true, "targets": ["current-C++-source", "release-validator-binary", "compiled-profile-digests"]},
    {"command_id": "central-consumer", "required": true, "targets": ["real-C++-closure-validator", "compiled-profile-digests", "negative-fences"]},
    {"command_id": "triton-smoke", "required": true, "targets": ["real-pinned-Triton", "model-control-none", "strict-readiness", "real-inference"]},
    {"command_id": "fault", "required": true, "targets": ["tamper", "archive-security", "SIGTERM", "SIGKILL-recovery", "no-overwrite"]},
    {"command_id": "performance", "required": true, "targets": ["five-runs", "p50-p95-p99", "throughput", "RSS-FD-output", "determinism"]},
    {"command_id": "image-build", "required": true, "targets": ["offline-image-build", "digest-pinned-base", "non-root", "source-label"]},
    {"command_id": "oci-smoke", "required": true, "targets": ["actual-OCI", "non-root", "read-only-rootfs", "network-none", "complete-job"]},
    {"command_id": "deployment-policy", "required": true, "targets": ["immutable-image", "bounded-terminating-job", "network-none", "no-host-authority"]},
    {"command_id": "supply-chain", "required": true, "targets": ["SPDX", "offline-Trivy", "Cosign", "lock-license-notices", "tamper-negative"]},
    {"command_id": "formal-soak", "required": true, "targets": ["60-second-warmup", "four-times-900-seconds", "monotonic-3600-seconds", "recovery", "resource-trend", "cleanup"]},
    {"command_id": "traceability", "required": true, "targets": ["exact-requirement-evidence-map", "schema-validation", "digest-references", "tamper-negatives", "machine-derived-completion"]}
  ],
  "public_contracts": [
