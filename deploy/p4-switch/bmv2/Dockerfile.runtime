# syntax=docker/dockerfile:1.7

FROM p4lang/behavioral-model@sha256:85905a1ecad8c26e1f746efdf9e66d3600ee743588b32fe5b65d7d3ad1c0157d AS builder

ARG SOURCE_DATE_EPOCH=1786406400
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

COPY . /behavioral-model/
WORKDIR /behavioral-model

RUN cmake -S . -B build-masi \
      -DWITH_PDFIXED=ON \
      -DWITH_PI=ON \
      -DWITH_STRESS_TESTS=ON \
      -DENABLE_DEBUGGER=ON \
      -DENABLE_WERROR=ON && \
    cmake --build build-masi --parallel "$(nproc)" && \
    ctest --test-dir build-masi --output-on-failure && \
    cmake --install build-masi --prefix /opt/masi-runtime

FROM p4lang/behavioral-model@sha256:85905a1ecad8c26e1f746efdf9e66d3600ee743588b32fe5b65d7d3ad1c0157d

# The upstream development image carries kernel headers into its final stage.
# They are not used by simple_switch_grpc and are the sole CRITICAL/HIGH OS
# vulnerability source in the qualified runtime, so remove the development
# closure before copying the target binary.
RUN apt-get purge -y linux-libc-dev libc6-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /var/cache/ldconfig/* \
       /var/log/alternatives.log /var/log/apt/* /var/log/dpkg.log

ARG SOURCE_DATE_EPOCH=1786406400
LABEL org.opencontainers.image.title="MASI-NIDS bounded simple_switch_grpc runtime" \
      org.opencontainers.image.source="https://github.com/p4lang/behavioral-model" \
      org.opencontainers.image.revision="693e69e634fedf007964a069fdd69acc441a5f80" \
      io.masi-nids.patch.sha256="0f0665b4db472680e17c5f2d9f5eddfa1e78201f4097f7cf5dd614a690b2597a" \
      io.masi-nids.source-date-epoch="${SOURCE_DATE_EPOCH}"

COPY --from=builder /opt/masi-runtime/bin/simple_switch_grpc /usr/local/bin/simple_switch_grpc

USER 65532:65532
