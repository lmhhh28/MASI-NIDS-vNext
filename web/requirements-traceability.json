    {"requirement_id":"DEP-WEB-001","scenario_ids":["TEST-WEB-OCI-001"],"command_ids":["production-build","oci-build-smoke","supply-chain"],"qualification_limit":"digest-pinned non-root static OCI and same-origin proxy; deployment tier qualification remains separate"},
    {"requirement_id":"TEST-002","scenario_ids":["TEST-WEB-LANGUAGE-001"],"command_ids":["lint","typecheck","unit-component-a11y"],"qualification_limit":"TypeScript/Vue language-level gate"},
    {"requirement_id":"TEST-003","scenario_ids":["TEST-WEB-BLACKBOX-001"],"command_ids":["browser-matrix","oci-build-smoke"],"qualification_limit":"real Web production artifact with contract fake neighbor; not formal Go-Web pairwise"},
    {"requirement_id":"TEST-008","scenario_ids":["TEST-WEB-SOAK-3600S-001"],"command_ids":["formal-soak"],"qualification_limit":"60-second excluded warmup plus four 900-second phases"},
    {"requirement_id":"TEST-009","scenario_ids":["TEST-WEB-EVIDENCE-001"],"command_ids":["findings","evidence-integrity","supply-chain","formal-soak"],"qualification_limit":"digest-bound command, source, browser, OCI, performance and soak evidence"},
    {"requirement_id":"TEST-GATE-001","scenario_ids":["TEST-WEB-MODULE-GATES-001"],"command_ids":["contracts","source-sentinels","lint","typecheck","unit-component-a11y","production-build","bundle-security","browser-matrix","oci-build-smoke","performance","supply-chain","formal-soak","findings","evidence-integrity"],"qualification_limit":"operational module completion only; nine-module Gate 2 and qualification fields remain independent"},
    {"requirement_id":"TEST-REAL-E2E-001","scenario_ids":["TEST-WEB-BLACKBOX-001"],"command_ids":["oci-build-smoke","browser-matrix"],"qualification_limit":"real Web candidate; formal P9 starts real Go/PostgreSQL and is separate evidence"}
