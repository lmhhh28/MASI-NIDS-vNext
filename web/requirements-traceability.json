    {"requirement_id":"CONTRACT-PLUGIN-STAT-001","scenario_ids":["TEST-WEB-PLUGIN-STAT-001"],"command_ids":["unit-component-a11y","browser-matrix","performance","formal-soak"],"qualification_limit":"Web consumer and fixed renderer portion; Go/Host/plugin execution remains separate"},
    {"requirement_id":"WEB-UX-001","scenario_ids":["TEST-WEB-UX-001"],"command_ids":["browser-matrix","unit-component-a11y"],"qualification_limit":"fixed task IA, URL/deep-link, all-state and narrow read-only behavior"},
    {"requirement_id":"WEB-STATE-001","scenario_ids":["TEST-WEB-STATE-001"],"command_ids":["unit-component-a11y","browser-matrix","formal-soak"],"qualification_limit":"bounded query cache, one SSE, gap refetch, jitter and polling fallback"},
    {"requirement_id":"WEB-GOV-001","scenario_ids":["TEST-WEB-GOV-001"],"command_ids":["browser-matrix"],"qualification_limit":"no optimistic dangerous mutation; exact context and maker-checker UI"},
    {"requirement_id":"WEB-VIS-001","scenario_ids":["TEST-WEB-VIS-001"],"command_ids":["unit-component-a11y","browser-matrix"],"qualification_limit":"project tokens, stable non-color states, host-owned charts and evidence rail"},
    {"requirement_id":"WEB-A11Y-001","scenario_ids":["TEST-WEB-A11Y-001"],"command_ids":["unit-component-a11y","browser-matrix"],"qualification_limit":"automated WCAG, keyboard/focus/reflow/reduced-motion; manual screen-reader review recorded separately"},
    {"requirement_id":"WEB-PERF-001","scenario_ids":["TEST-WEB-PERF-001"],"command_ids":["production-build","bundle-security","performance","formal-soak"],"qualification_limit":"frozen workstation and production artifact browser performance"},
    {"requirement_id":"WEB-SEC-001","scenario_ids":["TEST-WEB-SEC-001"],"command_ids":["source-sentinels","bundle-security","browser-matrix","oci-build-smoke"],"qualification_limit":"same-origin HttpOnly session, CSRF, CSP, no browser secret/runtime remote/offline mutation"},
    {"requirement_id":"WEB-SUPPLY-001","scenario_ids":["TEST-WEB-SUPPLY-001"],"command_ids":["supply-chain","production-build"],"qualification_limit":"exact lock/SBOM/notices/component decisions; project-wide distribution license remains Owner scope"},
