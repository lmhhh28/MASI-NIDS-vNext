{
  "schema_version": "web-spa-requirement-traceability/v1",
  "module_id": "MOD-WEB-001",
  "owner_role": "SOC Web module owner",
  "design_anchor": "docs/design/modules/web-soc-spa-design.md",
  "commands": {
    "stable": "scripts/run-module-gates.sh",
    "contracts": "node scripts/validate-contracts.mjs",
    "language": "npm run lint && npm run typecheck && npm run test",
    "production_build": "npm run build && npm run verify:bundle && npm run verify:security",
    "browser": "npm run test:e2e",
    "oci": "scripts/run-oci-smoke.sh",
    "performance": "node scripts/run-performance.mjs",
    "formal_soak": "node scripts/run-soak.mjs --warmup-seconds 60 --phase-seconds 900",
    "supply_chain": "npm run sbom && node scripts/validate-supply-chain.mjs"
  },
  "execution_bindings": [
    {"command_id":"contracts","required":true,"targets":["dashboard-schema","projection-envelope","OpenAPI-generated-client","web-profiles"]},
    {"command_id":"source-sentinels","required":true,"targets":["no-v-html-eval-service-worker-remote-runtime","no-placeholder","generated-client-only"]},
    {"command_id":"lint","required":true,"targets":["ESLint-zero-warning"]},
    {"command_id":"typecheck","required":true,"targets":["TypeScript-strict","Vue-SFC"]},
    {"command_id":"unit-component-a11y","required":true,"targets":["Vitest","Vue-Test-Utils","axe-core","negative-contracts"]},
    {"command_id":"production-build","required":true,"targets":["content-hashed-static-artifact","no-source-map"]},
    {"command_id":"bundle-security","required":true,"targets":["shell-route-CSS-budgets","CSP-sentinels","no-remote-runtime"]},
    {"command_id":"browser-matrix","required":true,"targets":["Chromium-1234","Firefox-1538","WebKit-2336","keyboard-reflow"]},
    {"command_id":"oci-build-smoke","required":true,"targets":["digest-pinned-build","UID-101","health","same-origin-proxy","deep-link","security-headers"]},
    {"command_id":"performance","required":true,"targets":["cold-warm","LAN-weak-network","LCP-INP-CLS","heap-DOM-long-task"]},
    {"command_id":"supply-chain","required":true,"targets":["lock-integrity","CycloneDX-SBOM","notices","component-registry"]},
    {"command_id":"formal-soak","required":true,"targets":["60-second-warmup","four-times-900-seconds","route-SSE-cache-recovery","resource-trends"]},
    {"command_id":"findings","required":true,"targets":["append-only-findings","open-P0-zero"]},
    {"command_id":"evidence-integrity","required":true,"targets":["command-log-digests","source-digest","summary-schema"]}
