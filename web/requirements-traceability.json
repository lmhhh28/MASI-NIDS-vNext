    {"requirement_id":"FUNC-GOV-001","scenario_ids":["TEST-WEB-GOV-001"],"command_ids":["unit-component-a11y","browser-matrix"],"qualification_limit":"R1/R2/R3 exact-context UI; server remains authorization owner"},
