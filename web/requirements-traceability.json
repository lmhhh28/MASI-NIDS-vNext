    {"requirement_id":"FUNC-FW-001","scenario_ids":["TEST-WEB-FW-001"],"command_ids":["browser-matrix"],"qualification_limit":"revision/bank/selector/activation UI; exact P4 execution evidence is P4/Edge/Go scope"},
    {"requirement_id":"FUNC-TARGET-FLEET-001","scenario_ids":["TEST-WEB-TARGET-FLEET-001"],"command_ids":["browser-matrix"],"qualification_limit":"target lifecycle and per-wave/per-target mixed projection"},
    {"requirement_id":"FUNC-INF-MODEL-001","scenario_ids":["TEST-WEB-MODEL-001"],"command_ids":["browser-matrix"],"qualification_limit":"exact current/previous/runtime/availability/rollout facts; no serving ownership"},
    {"requirement_id":"CONTRACT-001","scenario_ids":["TEST-WEB-CONTRACT-001"],"command_ids":["contracts","unit-component-a11y"],"qualification_limit":"strict runtime major/kind/cardinality guards plus generated compile-time client"},
