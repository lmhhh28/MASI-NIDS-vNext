{
  "name": "@masi-nids/soc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tanstack/vue-query": "5.102.5",
    "@tanstack/vue-virtual": "3.13.36",
    "@vueuse/core": "14.4.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.5",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "30.0.1",
    "sass": "1.103.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && node --test scripts/performance-evidence.test.mjs",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "npm run build && playwright test",
    "verify:bundle": "node scripts/check-bundle.mjs",
    "verify:security": "node scripts/check-security.mjs",
    "verify:contracts": "node scripts/validate-contracts.mjs",
    "verify:sentinels": "node scripts/check-source-sentinels.mjs",
    "verify:supply": "node scripts/validate-supply-chain.mjs",
    "performance": "node scripts/run-performance.mjs",
    "soak": "node scripts/run-soak.mjs",
    "module-gates": "MASI_WEB_FORMAL_SOAK=1 scripts/run-module-gates.sh",
    "sbom": "cyclonedx-npm --output-format JSON --output-file sbom.cdx.json --validate --omit dev",
    "verify": "npm run verify:contracts && npm run verify:sentinels && npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:bundle && npm run verify:security && npm run sbom && npm run verify:supply"
  }
}
