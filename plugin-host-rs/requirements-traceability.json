    {"requirement_id": "TEST-008", "scenario_ids": ["TEST-HOST-SOAK-3600S-001"], "command_ids": ["performance", "formal-soak"], "qualification_limit": "exact 60-second warmup plus steady/peak/saturation/recovery-activation 900-second stages"},
