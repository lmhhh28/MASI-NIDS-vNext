    {"requirement_id": "SEC-001", "scenario_ids": ["TEST-HOST-TLS-UDS-001"], "command_ids": ["release-blackbox", "oci-smoke"], "qualification_limit": "TLS1.3 exact manager leaf plus UDS owner/group/mode/no-symlink/SO_PEERCRED"},
