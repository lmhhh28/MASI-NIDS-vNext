    {"requirement_id": "TEST-010", "scenario_ids": ["TEST-HOST-MODULE-GATES-001"], "command_ids": ["format", "clippy", "unit-property-contract", "release-blackbox", "performance", "oci-smoke", "supply-chain", "formal-soak", "findings"], "qualification_limit": "Host Definition of Done with no required implementation/test/resource blocker and open P0 zero"},
