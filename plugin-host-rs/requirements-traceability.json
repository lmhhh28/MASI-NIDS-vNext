    {"requirement_id": "SEC-PLUGIN-002", "scenario_ids": ["TEST-HOST-SUPPLY-001"], "command_ids": ["supply-chain", "release-blackbox"], "qualification_limit": "Host artifact publisher/SBOM/provenance/offline verification/revocation slice"},
