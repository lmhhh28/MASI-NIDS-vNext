    {"requirement_id": "PLUGIN-PLAT-006", "scenario_ids": ["TEST-HOST-CONFORMANCE-001"], "command_ids": ["unit-property-contract", "release-blackbox"], "qualification_limit": "real service and Wasm conformance fixtures; official Analysis Module is not implemented by Host"},
