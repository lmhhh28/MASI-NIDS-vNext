{
  "schema_version": "plugin-runtime-host-requirement-manifest/v1",
  "module_id": "MOD-PLUGIN-001",
  "owner_role": "Plugin Runtime Host module owner",
  "design_anchor": "docs/masi-nids-vnext-system-requirements-2026-08-09.md#49-plugin-runtime-hostmod-plugin-001",
  "commands": {
    "stable": "scripts/run-module-gates.sh",
    "contracts": "python3 scripts/validate-contracts.py && cargo test --test contract_golden",
    "language": "cargo fmt --check && cargo clippy -- -D warnings && cargo test",
    "blackbox": "cargo test --release --test module_blackbox -- --test-threads=1",
    "performance": "scripts/run-performance.sh",
    "oci": "scripts/run-oci-smoke.sh",
    "supply_chain": "scripts/run-supply-chain.sh",
    "formal_soak": "scripts/run-soak.sh"
  },
  "execution_bindings": [
    {"command_id": "contract-schema", "required": true, "targets": ["JSON-Schema-2020-12", "Protobuf", "WIT", "profile-digest"]},
    {"command_id": "control-contract-consumer", "required": true, "targets": ["Go-public-contract-validator", "manifest-lifecycle-statistics-schema"]},
    {"command_id": "control-statistics-adapter", "required": true, "targets": ["Go-pluginstat", "Go-gRPC-statistics-adapter"]},
    {"command_id": "format", "required": true, "targets": ["rustfmt"]},
    {"command_id": "clippy", "required": true, "targets": ["all-targets", "all-features", "deny-warnings"]},
    {"command_id": "unit-property-contract", "required": true, "targets": ["unit", "property", "protobuf-golden", "Wasm-error-mapping"]},
    {"command_id": "release-build", "required": true, "targets": ["three-release-binaries", "locked"]},
    {"command_id": "release-blackbox", "required": true, "targets": ["real-release-Host", "real-service-fixture", "TLS1.3", "generation-monotonic-lifecycle", "authorized-rollback", "statistics-definition-revision-digest", "service-fault-matrix", "trust-reconcile"]},
    {"command_id": "wasm-fault-matrix", "required": true, "targets": ["fuel", "deadline", "caller-cancel", "epoch-interrupt", "linear-memory", "output-bound", "import-deny"]},
    {"command_id": "deep-checks", "required": true, "targets": ["audit", "license", "coverage", "Valgrind"]},
    {"command_id": "performance", "required": true, "targets": ["three-trials", "warmup", "concurrency-1-2-4-8-32", "minimum-typical-maximum", "over-capacity-queue-saturation", "wasm-compile-cold-instantiate-warm"]},
    {"command_id": "oci-smoke", "required": true, "targets": ["non-root", "read-only-rootfs", "mTLS", "graceful-stop"]},
    {"command_id": "supply-chain", "required": true, "targets": ["SBOM", "Trivy", "Cosign", "offline-verification"]},
    {"command_id": "formal-soak", "required": true, "targets": ["60-second-warmup", "four-times-900-seconds", "classified-saturation-rejection", "service-crash-restart", "queue-inflight-connection-resource-trends"]},
    {"command_id": "source-sentinels", "required": true, "targets": ["no-unfinished-implementation"]},
    {"command_id": "findings", "required": true, "targets": ["append-only-findings", "open-P0-zero"]},
    {"command_id": "rustdoc", "required": true, "targets": ["public-documentation"]},
    {"command_id": "traceability", "required": true, "targets": ["exact-requirement-evidence-map"]}
  ],
  "public_contracts": [
    "contracts/plugin/manifest/v1/schema.json",
    "contracts/plugin/config/v1/schema.json",
    "contracts/plugin/host/v1/host.proto",
    "contracts/plugin/host/v1/config.schema.json",
    "contracts/plugin/host/v1/verification-bundle.schema.json",
    "contracts/plugin/service/v1/service.proto",
    "contracts/plugin/wit/v1/pure-transform.wit",
    "contracts/plugin/statistics/v1/schema.json",
    "contracts/control-adapter/v1/control_adapter.proto",
    "contracts/profiles/v1/plugin-runtime-host.json",
    "contracts/profiles/v1/wasm-component.json",
    "contracts/profiles/v1/grpc-service.json",
    "contracts/profiles/v1/plugin-statistics.json",
    "contracts/profiles/v1/plugin-statistics-display.json",
    "contracts/supply-chain/v1/plugin-runtime-host-components.json",
    "contracts/supply-chain/v1/plugin-runtime-host-third-party-notices.json",
    "contracts/evidence/plugin-runtime-host-module/v1/schema.json"
  ],
  "requirements": [
    {"requirement_id": "MOD-PLUGIN-001", "scenario_ids": ["TEST-HOST-MODULE-GATES-001"], "command_ids": ["contract-schema", "release-blackbox", "performance", "oci-smoke", "formal-soak"], "qualification_limit": "independent Plugin Runtime Host operational completion; Go Manager, Analysis and formal pairwise/system qualification remain separate"},
    {"requirement_id": "ARCH-003", "scenario_ids": ["TEST-HOST-OWNERSHIP-001"], "command_ids": ["release-blackbox", "source-sentinels"], "qualification_limit": "Host executes admitted plugins only and owns no core PostgreSQL, P4, effect or business fact"},
    {"requirement_id": "ARCH-005", "scenario_ids": ["TEST-HOST-BOUNDS-001"], "command_ids": ["unit-property-contract", "release-blackbox", "performance", "formal-soak"], "qualification_limit": "Host-local connection, queue, in-flight, input, output, deadline, cache and observation bounds"},
    {"requirement_id": "ARCH-PLUGIN-001", "scenario_ids": ["TEST-HOST-OWNERSHIP-001"], "command_ids": ["contract-schema", "release-blackbox"], "qualification_limit": "Wasm and explicit Host-managed service execution isolation; independent Agent business traffic is not proxied"},
    {"requirement_id": "ARCH-REUSE-001", "scenario_ids": ["TEST-HOST-SUPPLY-001"], "command_ids": ["deep-checks", "supply-chain"], "qualification_limit": "exact Wasmtime/Tokio/Tonic/Rust adoption without transfer of canonical ownership"},
    {"requirement_id": "CONTRACT-001", "scenario_ids": ["TEST-HOST-CONTRACT-GOLDEN-001"], "command_ids": ["contract-schema", "unit-property-contract"], "qualification_limit": "public Protobuf, JSON Schema and WIT sources with explicit adapters"},
    {"requirement_id": "CONTRACT-PROFILE-001", "scenario_ids": ["TEST-HOST-CONTRACT-GOLDEN-001"], "command_ids": ["contract-schema", "unit-property-contract"], "qualification_limit": "exact runtime, service, statistics and display profiles; unknown major fails closed"},
    {"requirement_id": "CONTRACT-PLUGIN-001", "scenario_ids": ["TEST-HOST-ADMISSION-REJECT-001"], "command_ids": ["contract-schema", "control-contract-consumer", "release-blackbox"], "qualification_limit": "Host admission subset of manifest/config/artifact/trust/capability closure"},
    {"requirement_id": "CONTRACT-PLUGIN-002", "scenario_ids": ["TEST-HOST-WASM-SERVICE-001"], "command_ids": ["contract-schema", "control-contract-consumer", "unit-property-contract", "release-blackbox"], "qualification_limit": "Host runtime/lifecycle/errors for wasm-component/v1 and grpc-service/v1"},
    {"requirement_id": "CONTRACT-PLUGIN-STAT-001", "scenario_ids": ["TEST-HOST-STATISTICS-CONFORMANCE-001"], "command_ids": ["contract-schema", "control-contract-consumer", "control-statistics-adapter", "release-blackbox", "performance"], "qualification_limit": "Host frozen-input, execution and bounded Artifact finalization slice; Go persistence and Web display are separate"},
    {"requirement_id": "PLUGIN-STAT-001", "scenario_ids": ["TEST-HOST-STATISTICS-CONFORMANCE-001"], "command_ids": ["control-statistics-adapter", "release-blackbox", "formal-soak"], "qualification_limit": "Host-side deterministic statistics execution, validation, provenance and idempotency only"},
    {"requirement_id": "PLUGIN-PLAT-001", "scenario_ids": ["TEST-HOST-OWNERSHIP-001"], "command_ids": ["release-blackbox", "oci-smoke"], "qualification_limit": "independent execution isolation with core continuing outside this process"},
    {"requirement_id": "PLUGIN-PLAT-002", "scenario_ids": ["TEST-HOST-KIND-RUNTIME-001"], "command_ids": ["contract-schema", "release-blackbox"], "qualification_limit": "closed Host-managed pure-transform/read-only-tool and two exact runtime profiles; Analysis is direct"},
    {"requirement_id": "PLUGIN-PLAT-003", "scenario_ids": ["TEST-HOST-CAPABILITY-DENY-001"], "command_ids": ["unit-property-contract", "release-blackbox"], "qualification_limit": "default-deny capability, frozen bytes and no DB/P4/effect credentials in Host"},
    {"requirement_id": "PLUGIN-PLAT-004", "scenario_ids": ["TEST-HOST-SUPPLY-001"], "command_ids": ["release-blackbox", "supply-chain"], "qualification_limit": "offline signed artifact admission and runtime revocation freshness; Manager authorization is separate"},
