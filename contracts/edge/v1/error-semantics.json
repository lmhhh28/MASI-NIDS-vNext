{
  "schema_version": "edge-error-semantics/v1",
  "transport": "grpc-status-with-stable-message-prefix",
  "categories": [
    {
      "category": "INVALID_ARGUMENT",
      "grpc_code": "INVALID_ARGUMENT",
      "retry": "after-input-correction",
      "effect_outcome": "not-attempted"
    },
    {
      "category": "UNKNOWN_MAJOR",
      "grpc_code": "INVALID_ARGUMENT",
      "retry": "after-contract-upgrade",
      "effect_outcome": "not-attempted"
    },
    {
      "category": "ENDPOINT_NOT_ALLOWED",
      "grpc_code": "PERMISSION_DENIED",
      "retry": "after-registry-or-policy-change",
      "effect_outcome": "not-attempted"
    },
    {
      "category": "TLS_IDENTITY_MISMATCH",
      "grpc_code": "UNAUTHENTICATED",
      "retry": "after-identity-repair",
      "effect_outcome": "not-attempted"
    },
    {
      "category": "RESOURCE_EXHAUSTED",
      "grpc_code": "RESOURCE_EXHAUSTED",
      "retry": "bounded-backpressure",
      "effect_outcome": "not-attempted"
    },
    {
      "category": "PRECONDITION_FAILED",
      "grpc_code": "FAILED_PRECONDITION",
      "retry": "after-fence-or-state-reconcile",
      "effect_outcome": "not-attempted-unless-reason-is-readback"
    },
    {
      "category": "DEADLINE_EXCEEDED",
      "grpc_code": "DEADLINE_EXCEEDED",
      "retry": "within-declared-budget-only",
      "effect_outcome": "not-attempted-or-explicitly-reconciled"
    },
    {
      "category": "WAL_CORRUPT",
      "grpc_code": "FAILED_PRECONDITION",
      "retry": "operator-repair-required",
      "effect_outcome": "hold"
    },
    {
      "category": "LOCAL_IO",
      "grpc_code": "UNAVAILABLE",
      "retry": "bounded-after-local-recovery",
      "effect_outcome": "hold"
    },
    {
      "category": "REMOTE_FAILURE",
      "grpc_code": "UNAVAILABLE",
      "retry": "boundary-specific-bounded-budget",
      "effect_outcome": "not-attempted-unless-journal-says-write-started"
    },
    {
      "category": "WRITE_OUTCOME_UNCONFIRMED",
      "grpc_code": "ABORTED",
      "retry": "exact-readback-reconcile-before-any-new-write",
      "effect_outcome": "unknown"
    },
    {
      "category": "ACTOR_UNAVAILABLE",
      "grpc_code": "UNAVAILABLE",
      "retry": "after-actor-recovery",
      "effect_outcome": "not-attempted"
    }
  ],
  "quality_not_errors": [
    "VALID",
    "PARTIAL",
    "GAP",
    "RESET",
    "STALE",
    "NOT_COVERED",
    "NOT_MEASURABLE"
  ],
