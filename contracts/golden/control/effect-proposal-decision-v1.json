  "language_runners": ["go", "typescript"],
  "input": {
    "proposal": {
      "proposal_id": "prop-golden-0001",
      "actor_ref": "iss-golden:sub-proposer",
      "risk_level": "R2",
      "effect_kind": "firewall-baseline-activate",
      "target_set_digest": "sha256:11" ,
      "policy_digest": "sha256:22",
      "scope": "fleet-golden-0001"
    },
    "decision": {
      "proposal_id": "prop-golden-0001",
      "actor_ref": "iss-golden:sub-checker",
      "risk_level": "R2",
      "decision": "approve",
      "authz_context": {
