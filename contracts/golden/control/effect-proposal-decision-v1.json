        "phishing_resistant": true,
        "authz_context_level": "scoped-operator"
      }
    }
  },
  "expected": {
    "decision_binds_proposal_digest": true,
    "r2_maker_checker_ok": true,
    "r2_proposer_ne_approver": true,
    "r2_step_up_fresh": true,
    "intent_claimable": true,
    "proposal_claimable": false,
    "decision_claimable": false,
    "fleet_parent_claimable": false,
    "self_approval_rejected": true,
    "stale_step_up_rejected": "step_up_age_ms > 300000 -> HOLD, zero Edge RPC",
    "wrong_scope_rejected": "decision.scope != proposal.scope -> HOLD, zero Edge RPC"
  }
