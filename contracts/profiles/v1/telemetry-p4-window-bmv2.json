  "window": {
    "max_duration_ms": 60000,
    "allowed_lateness_ms": 1000,
    "watermark": "target-aggregate-export-time",
    "final_required_for_inference": true
  },
  "sampling": {
    "algorithm": "sequence-modulo",
    "selector": "source-sequence-modulo-period",
    "seed": "source-profile-digest",
    "weighting": "none-hint-only",
    "estimation_error_ppm": 1000000,
    "complete_population_claim": false,
    "period_packets": 1024,
    "digest_max_list_size": 16,
    "digest_max_timeout_ns": 100000000,
    "digest_ack_timeout_ns": 1000000000,
    "stream_queue_messages": 4096,
    "coverage": "explicit expected/observed/drop; never reliable or full by implication"
  },
  "quality": ["valid", "partial", "gap", "stale", "not-covered", "not-measurable", "invalid"],
  "flow_identity": {
    "schema_version": "telemetry-flow-identity-profile/v1",
    "shard": "stable target_id",
    "capture_adapter_id": "p4runtime-bounded-aggregate",
