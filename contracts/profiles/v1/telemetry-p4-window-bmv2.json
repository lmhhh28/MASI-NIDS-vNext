    "max_gap_ranges": 64
  },
  "p4_entities": {
    "selector_table_id": 33554694,
    "cell_counter_id": 301990147,
    "bank_counter_id": 301990148,
    "class_counter_id": 301990149,
    "sequence_register_id": 369099032,
    "sequence_register_p4runtime_readback": false,
    "digest_id": 388467505,
    "packet_in_metadata_id": 67109121
  },
  "snapshot": {
    "strategy": "flip-active-bank then read frozen-bank aggregate sequence before/cells/sequence after",
    "consistent_when": "sequence_before equals sequence_after and all 256 cells are observed",
