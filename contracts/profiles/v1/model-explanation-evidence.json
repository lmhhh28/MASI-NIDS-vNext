{
  "schema_version": "qualification-profile/v1",
  "profile_id": "model-explanation-evidence/v1",
  "schema": "contracts/model-explanation/v1/schema.json",
  "feature_profile": "edge-feature-p4-window/v1",
  "feature_order": [
    "aggregate_packets",
    "aggregate_bytes",
    "reported_nonzero_cells",
    "max_cell_packets",
    "max_cell_bytes",
    "snapshot_count"
  ],
  "methods": {
    "lr-window-binary/v1": {
      "method_id": "lr-raw-margin/v1",
      "domain": "raw-margin",
      "additivity": "intercept+sum(coefficient_j*scaled_log_feature_j)=raw_margin",
      "background": "not_applicable"
    },
    "xgb-window-binary/v1": {
      "method_id": "xgb-treeshap-interventional-raw/v1",
      "domain": "raw-margin",
      "tool": "TreeExplainer",
      "model_output": "raw",
      "feature_perturbation": "interventional",
      "background_selection": "deterministic-train-source-class-capture-family",
      "background_maximum": 256,
      "additivity": "base_value+sum(phi)=raw_margin"
    },
    "ae-window-benign/v1": {
      "method_id": "ae-scaled-log-smoothl1-residual/v1",
      "domain": "scaled-log-residual",
      "residual": "SmoothL1-beta-1-per-feature",
      "identity": "mean(residuals)=raw_anomaly_score",
      "background": "not_applicable"
    }
  },
  "sampling": {
    "local_sample_maximum": 4096,
    "per_source_scenario_maximum": 4096,
    "selection": "deterministic-blind-source-scenario-sample-id",
    "global_importance": "mean-absolute-contribution"
  },
  "stability": {
    "seeds": [17, 29, 43],
    "metric": "global-rank-spearman-median",
    "threshold": 0.8,
    "below_threshold": "unstable-and-cannot-be-described-as-stable-reason"
  },
  "numeric": {
    "finite_only": true,
    "absolute_tolerance_maximum": 0.001,
    "relative_tolerance_maximum": 0.001,
    "ulp_maximum": 16
  },
  "boundary": {
    "realtime_inference_wire_change": false,
    "canonical_event_identity": false,
    "effect_eligibility": false,
    "causal_claim": false,
    "llm_fill_or_generation": false,
    "executable_content": false
  },
  "golden_catalog": "contracts/model-explanation/v1/golden/catalog.json",
  "unknown_major": "reject",
  "unverified_minor": "reject"
}
