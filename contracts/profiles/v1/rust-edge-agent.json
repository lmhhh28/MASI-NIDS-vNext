{
  "schema_version": "qualification-profile/v1",
  "profile_id": "rust-edge-agent/v1",
  "contract_sources": [
    "contracts/edge/v1/edge.proto",
    "contracts/inference/v1/inference.proto",
    "contracts/inference/v1/profile.json",
    "contracts/edge/v1/error-semantics.json",
    "contracts/evidence/v1/edge-module-schema.json",
    "contracts/evidence/module-findings/v1/schema.json",
    "contracts/evidence/command/v1/schema.json",
    "contracts/evidence/edge-blackbox/v1/schema.json",
    "contracts/evidence/soak/v1/schema.json",
    "contracts/evidence/traceability/v1/schema.json",
    "contracts/supply-chain/v1/rust-edge-agent-release.schema.json",
    "contracts/profiles/v1/qualification-soak-3600s.json",
    "contracts/p4runtime/v1/p4runtime.proto",
    "contracts/target/v1/schema.json",
    "contracts/profiles/v1/p4runtime-edge-compatibility.json",
    "contracts/telemetry/v1/schema.json",
    "contracts/p4/firewall-policy/v1/schema.json",
    "contracts/p4/rule-observation/v1/schema.json"
  ],
  "runtime": {
    "language": "Rust",
    "toolchain_channel": "1.97.1",
    "async_runtime": "Tokio",
    "grpc": "Tonic/Prost",
    "p4runtime_wire": "1.4.1-compatible-subset",
    "p4runtime_target_capabilities": "1.3.0",
    "p4runtime_compatibility_profile": "p4runtime-edge-bmv2-v1model/v1"
  },
  "ownership": {
    "production_p4runtime_session_owner": "Rust Edge Agent",
    "production_p4runtime_writer_count_per_target": 1,
    "canonical_source_router_owner": "per-target TargetActor",
    "database_credentials": false,
    "local_inference": false,
    "secondary_effect_queue": false
  },
  "targets": {
    "implementation_max_targets": 32,
    "qualification_absolute_capacity_status": "OWNER_NOT_FROZEN_DEC_001",
    "high_priority_queue_per_target": 128,
    "telemetry_queue_per_target": 64,
    "observation_queue_per_target": 8,
    "stream_request_queue_per_target": 128,
    "stream_response_queue_per_target": 4096,
    "pending_digest_ack_queue_per_target": 256,
    "assignment_command_deadline_ms": 10000,
    "lease_min_ms": 1000,
    "lease_max_ms": 300000,
    "preflight_token_validity_ms": 30000,
    "preflight_total_deadline_ms": 10000,
    "scheduler_priority": [
      "mastership-effect-journal-readback",
      "telemetry-source-continuity",
      "rule-observation",
      "optional-gnmi-readonly"
    ]
  },
  "p4runtime": {
    "max_updates_per_write": 256,
    "max_entities_per_read": 256,
    "max_read_response_bytes": 1048576,
    "max_read_response_entities": 4096,
    "max_in_flight_reads_per_target": 1,
    "connect_deadline_ms": 10000,
    "arbitration_deadline_ms": 5000,
    "write_deadline_ms": 2000,
    "read_deadline_ms": 2000,
    "keepalive_interval_ms": 10000,
    "digest_hint_max_per_drain": 256,
    "packet_in_max_bytes": 2048,
    "write_atomicity": "CONTINUE_ON_ERROR",
    "response_loss": "reconcile-by-exact-readback",
    "fallback": "none"
  },
  "telemetry": {
    "source_profile": "telemetry-p4-window/v1",
    "default_window_duration_ms": 10000,
    "max_window_duration_ms": 60000,
    "allowed_lateness_ms": 1000,
    "max_out_of_order_ms": 5000,
    "idle_source_timeout_ms": 30000,
    "max_open_windows_per_target": 64,
    "max_cells_per_snapshot": 256,
    "max_gap_ranges": 64,
    "final_valid_only_for_inference": true,
    "reopen_after_final": false,
    "zero_fill_missing": false,
    "digest_packet_in_semantics": "best-effort-hint-only",
    "raw_payload": false
  },
  "wal": {
    "format": "masi-edge-wal/v1",
    "header_bytes": 36,
    "recorded_at_header_field": "unsigned-unix-ms-with-nondecreasing-cross-record-fence",
    "checksum": "CRC32C",
    "fsync_before_external_advance": true,
    "atomic_checkpoint": "temp-write-fsync-rename-directory-fsync",
    "segment_bytes": 67108864,
    "max_record_bytes": 4194304,
    "source_max_bytes_per_target": 1073741824,
    "source_max_records_per_target": 1048576,
    "input_max_bytes_per_target": 2147483648,
    "input_max_records_per_target": 524288,
    "pending_input_identities_per_target": 524288,
    "result_max_bytes_per_target": 2147483648,
    "result_max_records_per_target": 524288,
    "journal_max_bytes_per_target": 536870912,
    "journal_max_records_per_target": 262144,
    "route_journal_max_bytes_per_target": 67108864,
    "route_journal_max_records_per_target": 4096,
    "max_age_seconds": 86400,
    "age_expiry": "sticky-target-HOLD-without-delete-overwrite-or-external-advance",
    "clock_regression_or_future_record": "WAL_CLOCK_UNPROVABLE-and-sticky-target-HOLD",
    "high_watermark_ratio": 0.80,
    "critical_watermark_ratio": 0.95,
    "overwrite_unacknowledged": false,
    "corruption": "fail-closed-except-incomplete-final-tail"
  },
  "inference": {
    "wire_profile": "inference-central-grpc-batch/v1",
    "transport": "mutual-tls-batched-unary",
    "max_records_per_batch": 256,
    "max_request_bytes": 4194304,
    "max_response_bytes": 4194304,
    "max_in_flight_batches_per_target": 1,
    "request_deadline_ms": 2000,
    "same_generation_max_attempts": 3,
    "retry_backoff_ms": [25, 100],
    "retryable_grpc_codes": ["UNAVAILABLE", "RESOURCE_EXHAUSTED", "ABORTED"],
    "deadline_scope": "global-across-attempts-and-backoffs",
    "coalescing_delay_ms": 0,
    "channel_reuse": true,
    "compression": "none",
    "client_keepalive": "disabled",
    "client_side_load_balancer": "none",
    "endpoint_source": "immutable-inference-route",
    "committed_binding_handshake": "inference-committed-binding/v1",
    "committed_binding_wal_stage": "CANONICAL_ACTIVE",
    "duplicate_handshake": "exact-tuple-idempotent-without-WAL-append",
    "changed_handshake": "ROUTE_FENCE_MISMATCH",
    "resume_watermark": "source-input-result-WAL-checkpoint-and-last-sequence",
    "result_fence": "complete-route-binding-profile-worker-attempt-and-WAL-identity",
    "cross_generation_retry": false,
    "edge_local_fallback": false,
    "cpu_cuda_automatic_switch": false,
    "old_model_fallback": false
  },
  "control_sink": {
    "transport": "mutual-tls",
    "max_results_per_batch": 256,
    "max_batch_bytes": 4194304,
    "max_in_flight_batches": 2,
    "rpc_deadline_ms": 2000,
    "max_rule_observation_batch": 256,
    "max_queued_rule_observation_batches_per_target": 8,
    "canonical_ack": "PostgreSQL-Event-commit-only"
  },
  "firewall": {
    "profile": "p4-stateless-firewall/v1",
    "baseline_rules": 4096,
    "response_overlay_rules": 1024,
    "response_overlay_max_ttl_seconds": 1800,
    "expiry_mutation_source": "Go-owned-durable-effect-intent-only",
    "edge_in_memory_timer_is_not_delete_authority": true,
    "banks": 2,
    "selector_entries": 1,
    "compile_expansion_per_rule": 1,
    "inactive_bank_exact_readback_required": true,
    "selector_exact_readback_required": true,
    "unsupported": [
      "ipv6-effect",
      "stateful",
      "nat",
      "rate-limit",
      "port-range",
      "hardware-target"
    ]
  },
  "rule_observation": {
    "profile": "p4-rule-observation-bmv2/v1",
    "max_rules_per_sweep": 4096,
    "max_entities_per_read": 256,
    "read_deadline_ms": 2000,
    "max_response_bytes": 1048576,
    "poll_clear": false,
    "edge_computes_ratio": false
  },
  "security": {
    "all_grpc_transport": "mutual-tls",
    "plaintext_fallback": false,
    "redirect": false,
    "proxy": false,
    "endpoint_sources": ["target-assignment", "inference-route", "static-control-sink-config"],
    "production_reject_ip_classes": ["loopback", "link-local", "metadata", "public", "unspecified", "multicast"],
    "module_test_loopback": "exact-explicit-allowlist-only",
    "dns_rebinding": "reject-if-any-resolution-outside-allowlist",
    "tls_server_name_required": true,
    "edge_control_client_identity": "CA-chain-plus-exact-leaf-DER-SHA256-allowlist",
    "edge_control_client_certificate_allowlist_max": 32,
    "separate_identity_refs": ["p4runtime", "central-inference", "control-sink", "edge-control-server"],
    "secrets_in_logs": false,
    "host_firewall_backend": false
  },
  "conditional_profiles": {
    "target_gnmi_readonly_v1": "NOT_APPLICABLE_NOT_TRIGGERED",
    "mirror_packet_mmap_v1": "NOT_APPLICABLE_P4_FEATURES_SUFFICIENT",
    "mirror_af_xdp_v1": "NOT_APPLICABLE_PACKET_MMAP_NOT_TRIGGERED",
    "mirror_dpdk_v1": "NOT_APPLICABLE_AF_XDP_NOT_TRIGGERED",
    "inference_shm_spsc_v1": "REJECT_PRODUCTION",
    "inference_uds_batch_v1": "REJECT_PRODUCTION"
  },
  "performance_gate": {
    "required_rule_counts": [0, 128, 1024, 4096],
    "required_target_counts": [0, 1, 2, "N"],
    "required_phases": ["steady", "peak", "saturation", "recovery-or-activation"],
    "warmup_seconds": 60,
    "soak_seconds": 3600,
    "absolute_threshold_status": "HOLD_OWNER_NOT_FROZEN_DEC_001",
    "process_resource_threshold_status": "OBSERVED_ONLY_OWNER_NOT_FROZEN_DEC_001",
    "soak_enforced_resource_limits": [
      "configured-aggregate-target-queue-depth",
      "configured-source-wal-bytes",
      "configured-input-wal-bytes",
      "configured-result-wal-bytes"
    ],
    "qualification_without_frozen_thresholds": "HOLD/NOT_QUALIFIED"
  },
  "stable_error_registry": {
    "source": "contracts/edge/v1/error-semantics.json",
    "category_field": "categories",
    "reason_code_field": "stable_reason_codes",
    "status_reason_code_field": "stable_status_reason_codes",
    "transport_codes_are_not_business_reason_codes": true
  }
}
