{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/plugin/manifest/v1/schema.json",
  "title": "Plugin Manifest Revision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_revision",
    "manifest_digest",
    "plugin_id",
    "plugin_revision",
    "kind",
    "publisher",
    "version",
    "scope",
    "artifact_digest",
    "artifact_media_type",
    "entrypoint",
    "supported_platforms",
    "host_api_version",
    "input_contract_digest",
    "output_contract_digest",
    "config_schema_id",
    "config_schema_version",
    "config_schema_digest",
    "capabilities",
    "skill_ids",
    "mcp_tool_ids",
    "mcp_resource_ids",
    "a2a_peer_ids",
    "network_egress_capability_ids",
    "filesystem_preopens",
    "secret_ref_ids",
    "statistics_definitions",
    "resource_limits",
    "runtime_profile",
    "wit_digest",
    "service_proto_digest",
    "sbom_digest",
    "provenance_digest",
    "signature_status",
    "verification_policy_digest",
    "verification_bundle_profile",
    "owner_ref",
    "support_level",
    "compatibility",
    "lifecycle_contract",
    "observability_contract_digest",
    "actor_ref",
    "reason_code",
    "trace_id",
    "created_at_unix_ms"
  ],
  "properties": {
    "schema_version": {"const": "masi-plugin-manifest/v1"},
    "manifest_id": {"$ref": "#/$defs/identity"},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "plugin_id": {"$ref": "#/$defs/identity"},
    "plugin_revision": {"$ref": "#/$defs/identity"},
    "kind": {"enum": ["analysis-agent", "read-only-tool", "pure-transform"]},
    "publisher": {"$ref": "#/$defs/identity"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"type": "string", "minLength": 1, "maxLength": 256},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "artifact_media_type": {"enum": ["application/wasm", "application/vnd.oci.image.manifest.v1+json"]},
    "entrypoint": {"type": "string", "minLength": 1, "maxLength": 256},
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["wasm32-wasip2", "linux/amd64", "linux/arm64"]}
    },
    "host_api_version": {"const": "plugin-host-control/v1"},
    "input_contract_digest": {"$ref": "#/$defs/digest"},
    "output_contract_digest": {"$ref": "#/$defs/digest"},
    "config_schema_id": {"const": "plugin-config/v1"},
    "config_schema_version": {"const": "masi-plugin-config/v1"},
    "config_schema_digest": {"$ref": "#/$defs/digest"},
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "skill_ids": {"$ref": "#/$defs/identity_array"},
    "mcp_tool_ids": {"$ref": "#/$defs/identity_array"},
    "mcp_resource_ids": {"$ref": "#/$defs/identity_array"},
    "a2a_peer_ids": {"$ref": "#/$defs/identity_array"},
    "network_egress_capability_ids": {"$ref": "#/$defs/identity_array"},
    "filesystem_preopens": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "secret_ref_ids": {"$ref": "#/$defs/identity_array"},
    "statistics_definitions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/statistics_definition_ref"}
    },
    "resource_limits": {"$ref": "#/$defs/resource_limits"},
    "runtime_profile": {"enum": ["wasm-component/v1", "grpc-service/v1"]},
    "wit_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "service_proto_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "sbom_digest": {"$ref": "#/$defs/digest"},
    "provenance_digest": {"$ref": "#/$defs/digest"},
    "signature_status": {"enum": ["signed", "unsigned", "rejected"]},
    "verification_policy_digest": {"$ref": "#/$defs/digest"},
    "verification_bundle_profile": {"const": "plugin-verification-bundle/v1"},
    "owner_ref": {"$ref": "#/$defs/identity"},
    "support_level": {"enum": ["first-party", "supported", "best-effort"]},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "lifecycle_contract": {"$ref": "#/$defs/lifecycle_contract"},
    "observability_contract_digest": {"$ref": "#/$defs/digest"},
    "actor_ref": {"$ref": "#/$defs/identity"},
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "trace_id": {"$ref": "#/$defs/identity"},
    "created_at_unix_ms": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"runtime_profile": {"const": "wasm-component/v1"}},
        "required": ["runtime_profile"]
      },
      "then": {
        "properties": {
          "wit_digest": {"$ref": "#/$defs/digest"},
          "artifact_media_type": {"const": "application/wasm"},
          "entrypoint": {"const": "masi:plugin-transform@1.0.0#transform"},
          "supported_platforms": {"const": ["wasm32-wasip2"]},
          "network_egress_capability_ids": {"maxItems": 0},
          "filesystem_preopens": {"maxItems": 0},
          "secret_ref_ids": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"runtime_profile": {"const": "grpc-service/v1"}},
        "required": ["runtime_profile"]
      },
      "then": {
        "properties": {
          "service_proto_digest": {"$ref": "#/$defs/digest"},
          "artifact_media_type": {"const": "application/vnd.oci.image.manifest.v1+json"}
        }
      }
    },
    {
      "if": {
        "properties": {"kind": {"const": "read-only-tool"}},
        "required": ["kind"]
      },
      "then": {}
    }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "identity_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    },
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_kind", "declared"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/capability_id"},
        "capability_kind": {
          "enum": [
            "read-source",
            "host-projection",
            "read-only-tool",
            "pure-transform",
            "external-source-readonly",
            "a2a-agent",
            "mcp-tool",
            "mcp-resource"
          ]
        },
        "declared": {"type": "boolean"}
      }
    },
    "statistics_definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "definition_revision", "definition_digest"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/identity"},
        "definition_revision": {"$ref": "#/$defs/identity"},
        "definition_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_api_min", "host_api_max", "runtime_profile", "migration_required", "rollback_compatible_revisions"],
      "properties": {
        "host_api_min": {"const": "plugin-host-control/v1"},
        "host_api_max": {"const": "plugin-host-control/v1"},
        "runtime_profile": {"enum": ["wasm-component/v1", "grpc-service/v1"]},
        "migration_required": {"type": "boolean"},
        "rollback_compatible_revisions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identity"}
        }
      }
    },
    "lifecycle_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness", "drain", "failure", "fallback"],
      "properties": {
        "startup": {"const": "plugin-startup/fail-closed-v1"},
        "readiness": {"const": "plugin-readiness/exact-binding-v1"},
        "liveness": {"const": "plugin-liveness/progress-v1"},
        "drain": {"const": "plugin-drain/bounded-v1"},
        "failure": {"const": "plugin-failure/stable-reason-v1"},
        "fallback": {"const": "plugin-fallback/none-v1"}
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_milli",
        "memory_bytes",
        "pid_count",
        "fd_count",
        "disk_bytes",
        "linear_memory_bytes",
        "table_elements",
        "instance_count",
        "batch_records",
        "in_flight_bytes",
        "concurrency",
        "deadline_ms",
        "retry_max_attempts",
        "output_bytes",
        "queue_depth"
      ],
      "properties": {
        "cpu_milli": {"type": "integer", "minimum": 0, "maximum": 65536},
        "memory_bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184},
        "pid_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "fd_count": {"type": "integer", "minimum": 0, "maximum": 65536},
        "disk_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "linear_memory_bytes": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "table_elements": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "instance_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "batch_records": {"type": "integer", "minimum": 1, "maximum": 10000},
        "in_flight_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 128},
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "retry_max_attempts": {"type": "integer", "minimum": 1, "maximum": 1},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "queue_depth": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    }
  },
  "x-masi-semantic-constraints": [
    {"constraint_id": "MANIFEST-IMMUTABLE-REVISION", "scope": ["/manifest_id"], "operator": "append-only-revision", "field": "/manifest_revision"},
    {"constraint_id": "MANIFEST-DIGEST-BINDS-REVISION", "fields": ["/manifest_revision", "/manifest_digest"], "operator": "digest-binds-revision"},
    {"constraint_id": "MANIFEST-CAPABILITY-DECLARED-ONLY", "fields": ["/capabilities"], "operator": "no-undeclared-capability"},
    {"constraint_id": "MANIFEST-EXTERNAL-SOURCE-READONLY-TOOL-ONLY", "fields": ["/capabilities", "/kind"], "operator": "external-source-requires-readonly-tool"}
  ]
}
