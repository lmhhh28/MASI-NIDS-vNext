{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/plugin/host/v1/config.schema.json",
  "title": "Plugin Runtime Host Configuration V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "host_id", "profile_id", "listen_address", "health_address",
    "artifact_cache_root", "server_tls", "trust", "limits", "service_endpoints"
  ],
  "properties": {
    "schema_version": {"const": "plugin-host-config/v1"},
    "host_id": {"$ref": "#/$defs/identity"},
    "profile_id": {"const": "plugin-runtime-host/v1"},
    "listen_address": {"type": "string", "pattern": "^[A-Za-z0-9.:-]{3,128}$"},
    "health_address": {"type": "string", "pattern": "^[A-Za-z0-9.:-]{3,128}$"},
    "artifact_cache_root": {"type": "string", "pattern": "^/[^\\u0000]{1,1023}$"},
    "server_tls": {"$ref": "#/$defs/server_tls"},
    "trust": {"$ref": "#/$defs/trust"},
    "limits": {"$ref": "#/$defs/limits"},
    "service_endpoints": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/service_endpoint"}
    }
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "server_tls": {
      "type": "object", "additionalProperties": false,
      "required": ["certificate_path", "private_key_path", "client_ca_path", "allowed_client_certificate_sha256"],
      "properties": {
        "certificate_path": {"type": "string", "pattern": "^/[^\\u0000]{1,1023}$"},
        "private_key_path": {"type": "string", "pattern": "^/[^\\u0000]{1,1023}$"},
        "client_ca_path": {"type": "string", "pattern": "^/[^\\u0000]{1,1023}$"},
        "allowed_client_certificate_sha256": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["trust_policy_digest", "revocation_max_age_ms", "publishers"],
      "properties": {
        "trust_policy_digest": {"$ref": "#/$defs/digest"},
        "revocation_max_age_ms": {"type": "integer", "minimum": 1000, "maximum": 300000},
        "publishers": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["publisher_identity", "ed25519_public_key_hex"],
            "properties": {
              "publisher_identity": {"$ref": "#/$defs/identity"},
              "ed25519_public_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": [
        "max_bindings", "global_queue_depth", "per_binding_queue_depth", "per_binding_in_flight",
        "max_control_message_bytes", "max_input_bytes", "max_output_bytes", "max_deadline_ms",
        "queue_wait_ms", "wasm_fuel", "wasm_linear_memory_bytes", "wasm_table_elements",
        "wasm_instances", "wasm_memories", "wasm_tables", "wasm_stack_bytes", "epoch_tick_ms",
        "failure_threshold", "circuit_open_ms", "restart_window_ms", "max_restarts_in_window",
        "quarantine_ms", "drain_deadline_ms", "shutdown_deadline_ms"
      ],
      "properties": {
        "max_bindings": {"type": "integer", "minimum": 1, "maximum": 32},
        "global_queue_depth": {"type": "integer", "minimum": 1, "maximum": 64},
        "per_binding_queue_depth": {"type": "integer", "minimum": 1, "maximum": 32},
        "per_binding_in_flight": {"type": "integer", "minimum": 1, "maximum": 2},
        "max_control_message_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_deadline_ms": {"type": "integer", "minimum": 1, "maximum": 10000},
        "queue_wait_ms": {"type": "integer", "minimum": 1, "maximum": 1000},
        "wasm_fuel": {"type": "integer", "minimum": 1000, "maximum": 50000000},
        "wasm_linear_memory_bytes": {"type": "integer", "minimum": 65536, "maximum": 67108864},
        "wasm_table_elements": {"type": "integer", "minimum": 1, "maximum": 10000},
        "wasm_instances": {"type": "integer", "minimum": 1, "maximum": 32},
        "wasm_memories": {"type": "integer", "minimum": 1, "maximum": 2},
        "wasm_tables": {"type": "integer", "minimum": 1, "maximum": 4},
        "wasm_stack_bytes": {"type": "integer", "minimum": 65536, "maximum": 2097152},
        "epoch_tick_ms": {"type": "integer", "minimum": 1, "maximum": 100},
        "failure_threshold": {"type": "integer", "minimum": 1, "maximum": 16},
        "circuit_open_ms": {"const": 1000},
        "restart_window_ms": {"const": 600000},
        "max_restarts_in_window": {"const": 5},
        "quarantine_ms": {"const": 900000},
        "drain_deadline_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
        "shutdown_deadline_ms": {"type": "integer", "minimum": 100, "maximum": 60000}
      }
    },
    "service_endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint_ref", "transport", "uds_path", "expected_uid", "expected_gid", "expected_workload_identity", "service_proto_digest", "artifact_digest"],
      "properties": {
        "endpoint_ref": {"$ref": "#/$defs/identity"},
        "transport": {"const": "uds"},
        "uds_path": {"type": "string", "pattern": "^/[^\\u0000]{1,1023}\\.sock$"},
        "expected_uid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "expected_gid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "expected_workload_identity": {"$ref": "#/$defs/identity"},
        "service_proto_digest": {"$ref": "#/$defs/digest"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
