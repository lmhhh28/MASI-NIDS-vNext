{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/offline-ml-oci/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "level", "applicability", "result", "qualification", "image_ref", "image_id", "source_tree_digest", "runtime_profile", "user", "entrypoint", "version", "container_id", "full_pipeline_exit_code", "full_pipeline_elapsed_ms", "candidate_executions", "dataset_revision", "model_digest", "repository_closure_digest", "archive_digest", "expected_blackbox_digest", "expected_immutable_identity", "cross_runtime_identity_match", "output_verification", "isolation", "service_health_endpoints", "logs_digest"],
  "properties": {
    "schema_version": {"const": "offline-ml-oci-evidence/v1"},
    "module_id": {"const": "MOD-ML-001"},
    "level": {"const": "MODULE"},
    "applicability": {"const": "APPLICABLE"},
    "result": {"const": "PASS"},
    "qualification": {"const": "NOT_QUALIFIED"},
    "image_ref": {"type": "string", "minLength": 1},
    "image_id": {"$ref": "#/$defs/digest"},
    "source_tree_digest": {"$ref": "#/$defs/digest"},
    "runtime_profile": {"const": "offline-ml-runtime/v1"},
    "user": {"const": "65532:65532"},
    "entrypoint": {"const": ["/usr/local/bin/masi-offline-ml"]},
    "version": {"const": "masi-offline-ml 1.0.0"},
    "container_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_pipeline_exit_code": {"const": 0},
    "full_pipeline_elapsed_ms": {"type": "number", "maximum": 30000},
    "candidate_executions": {"const": 9},
    "dataset_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "repository_closure_digest": {"$ref": "#/$defs/digest"},
    "archive_digest": {"$ref": "#/$defs/digest"},
    "expected_blackbox_digest": {"$ref": "#/$defs/digest"},
    "expected_immutable_identity": {"type": "object", "additionalProperties": false, "required": ["model_digest", "repository_closure_digest", "archive_digest"], "properties": {"model_digest": {"$ref": "#/$defs/digest"}, "repository_closure_digest": {"$ref": "#/$defs/digest"}, "archive_digest": {"$ref": "#/$defs/digest"}}},
    "cross_runtime_identity_match": {"const": true},
    "output_verification": {"type": "object", "required": ["result"], "properties": {"result": {"const": "PASS"}}},
    "isolation": {"type": "object", "minProperties": 9, "properties": {"network_none": {"const": true}, "read_only_rootfs": {"const": true}, "non_root": {"const": true}, "cap_drop_all": {"const": true}, "no_new_privileges": {"const": true}, "bounded_tmpfs": {"const": true}}},
    "service_health_endpoints": {"type": "object", "properties": {"applicability": {"const": "NOT_APPLICABLE"}, "stable_reason": {"type": "string"}}, "required": ["applicability", "stable_reason"]},
    "logs_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
