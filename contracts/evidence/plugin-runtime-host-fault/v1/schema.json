{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/plugin-runtime-host-fault/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "module_id", "runtime_profiles", "case_ids", "cases",
    "host_remained_available", "unclassified_failures", "result",
    "qualification", "reason_code"
  ],
  "properties": {
    "schema_version": {"const": "plugin-host-fault-evidence/v1"},
    "module_id": {"const": "MOD-PLUGIN-001"},
    "runtime_profiles": {"const": ["grpc-service/v1"]},
    "case_ids": {"const": [
      "service-hang", "service-trap", "service-wrong-digest", "service-oversize",
      "service-caller-cancellation", "service-crash-isolation", "service-disable-failure",
      "service-disable-hang", "service-drain-hang", "trust-freshness-reconcile",
      "service-failure-quarantine"
    ]},
    "cases": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/case"}
    },
    "host_remained_available": {"const": true},
    "unclassified_failures": {"const": 0},
    "result": {"const": "PASS"},
    "qualification": {"const": "NOT_QUALIFIED"},
    "reason_code": {"const": "PLUGIN_HOST_FAULT_MATRIX_PASS"}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "fault", "stable_reason", "bounded_millis", "recovered", "result"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "fault": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "stable_reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "bounded_millis": {"type": "integer", "minimum": 0, "maximum": 10000},
        "recovered": {"type": "boolean"},
        "result": {"const": "PASS"}
      }
    }
  }
}
