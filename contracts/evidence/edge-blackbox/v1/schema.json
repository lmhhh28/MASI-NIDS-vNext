{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/edge-blackbox/v1/schema.json",
  "title": "RustEdgeBlackboxEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "requirement_ids",
    "level",
    "applicability",
    "result",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "edge-module-e2e-evidence/v1",
        "edge-module-fault-evidence/v1",
        "edge-fault-evidence/v1",
        "edge-security-evidence/v1",
        "edge-telemetry-evidence/v1",
        "edge-resource-bound-evidence/v1",
        "edge-rule-observation-evidence/v1",
        "edge-os-fault-evidence/v1",
        "edge-target-capacity-rehearsal/v1",
        "edge-performance-rehearsal/v1"
      ]
    },
    "test_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
    },
    "level": {"enum": ["REHEARSAL", "MODULE"]},
    "applicability": {"const": "APPLICABLE"},
    "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "ack_order_reversed_relative_to_result": {"type": "boolean"},
    "active_streams_after_failed_connect": {"type": "integer", "minimum": 0},
    "actor_state": {"type": "string", "maxLength": 128},
    "admitted_targets_before_exhaustion": {"type": "integer", "minimum": 0},
    "attempt_budget": {"type": "integer", "minimum": 0},
    "attempts_per_timed_out_cycle": {"type": "integer", "minimum": 0},
    "automatic_delete_or_overwrite": {"type": "boolean"},
    "batch_digest_exact": {"type": "boolean"},
    "batch_digest_stable": {"type": "boolean"},
    "burst_requests": {"type": "integer", "minimum": 0},
    "canonical_ack_after_recovery": {"type": "boolean"},
    "canonical_commit_count": {"type": "integer", "minimum": 0},
    "canonical_commit_retry_digest_stable": {"type": "boolean"},
    "canonical_commits": {"type": "integer", "minimum": 0},
    "canonical_commits_during_outage": {"type": "integer", "minimum": 0},
    "central_calls": {"type": "integer", "minimum": 0},
    "central_retry_identity_stable": {"type": "boolean"},
    "configured_bytes": {"type": "integer", "minimum": 0},
    "configured_entity_limit": {"type": "integer", "minimum": 0},
    "configured_hint_queue_depth": {"type": "integer", "minimum": 0},
    "configured_max_age_seconds": {"type": "integer", "minimum": 0},
    "configured_nofile": {"type": "integer", "minimum": 0},
    "configured_pending_digest_ack_queue": {"type": "integer", "minimum": 0},
    "configured_queue_depth": {"type": "integer", "minimum": 0},
    "control_calls": {"type": "integer", "minimum": 0},
    "control_commit_calls": {"type": "integer", "minimum": 0},
    "crash_recovery_idempotent": {"type": "boolean"},
    "cross_purpose_client_identity_reuse_rejected": {"type": "boolean"},
    "deadline_ms": {"type": "integer", "minimum": 0},
    "deadline_scope": {"type": "string", "maxLength": 128},
    "digest_ack_references_durable_sequence": {"type": "boolean"},
    "digest_id": {"type": "integer", "minimum": 0},
    "digest_list_id": {"type": "integer", "minimum": 0},
    "digest_wal_sequence": {"type": "integer", "minimum": 0},
    "direct_counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packets", "bytes"],
      "properties": {
        "packets": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "duplicate_response_idempotent": {"type": "boolean"},
    "duplicate_wal_append": {"type": "boolean"},
    "duplicate_write_after_restart": {"type": "boolean"},
    "durable_gap_records": {"type": "integer", "minimum": 0},
    "durable_result_digest_stable": {"type": "boolean"},
    "durable_unacknowledged_digest_records": {"type": "integer", "minimum": 0},
    "edge_local_fallback": {"type": "boolean"},
    "edge_process": {"type": "string", "maxLength": 128},
    "effect_expected_entries": {"type": "integer", "minimum": 0},
    "effect_observed_entries": {"type": "integer", "minimum": 0},
    "effect_write_attempts": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "eligible_counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packets", "bytes"],
      "properties": {
        "packets": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "errno": {"type": "integer", "minimum": 0},
    "exact_digest_mismatch_fenced": {"type": "boolean"},
    "expired_actor_write_attempts": {"type": "integer", "minimum": 0},
    "expired_first_admission_rejected": {"type": "boolean"},
    "fail_closed": {"type": "boolean"},
    "fail_closed_before_actor_admission": {"type": "boolean"},
    "fault": {"type": "string", "maxLength": 256},
    "faults": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
    "filler_bytes": {"type": "integer", "minimum": 0},
    "first_election_ceiling": {"type": "integer", "minimum": 0},
    "forced_disconnects": {"type": "integer", "minimum": 0},
    "formal_soak_executed": {"type": "boolean"},
    "formal_soak_seconds_required": {"type": "integer", "minimum": 0},
    "grpc_code": {"type": "string", "maxLength": 128},
    "identity_mapped_not_position_mapped": {"type": "boolean"},
    "implementation_target_count": {"type": "integer", "minimum": 0},
    "inference_calls": {"type": "integer", "minimum": 0},
    "injected_entities": {"type": "integer", "minimum": 0},
    "injected_packet_hints": {"type": "integer", "minimum": 0},
    "installation_readback": {"type": "string", "maxLength": 128},
    "malformed_ack_rejected": {"type": "boolean"},
    "maximum_active_streams": {"type": "integer", "minimum": 0},
    "maximum_active_streams_per_device": {"type": "integer", "minimum": 0},
    "maximum_concurrent_streams_per_device": {"type": "integer", "minimum": 0},
    "measurements": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
    "metadata_endpoint_rejected": {"type": "boolean"},
    "minimum_backoff_ms": {"type": "integer", "minimum": 0},
    "neighbor_boundary": {"type": "string", "maxLength": 128},
    "no_fallback": {"type": "boolean"},
    "observed_open_fds": {"type": "integer", "minimum": 0},
    "observed_source_wal_bytes": {"type": "integer", "minimum": 0},
    "overall_module_complete": {"type": "boolean"},
    "p4_effect_write_attempts": {"type": "integer", "minimum": 0},
    "p4_rpc_deadline_ms": {"type": "integer", "minimum": 0},
    "p4_stream_opens": {"type": "integer", "minimum": 0},
    "packet_action_outcome_inferred_from_counter": {"type": "boolean"},
    "packet_in_ack_emitted": {"type": "boolean"},
    "packet_in_durable": {"type": "boolean"},
    "phase": {"type": "string", "maxLength": 128},
    "plaintext_rejected": {"type": "boolean"},
    "proc_limit": {"type": "string", "maxLength": 128},
    "process_live": {"type": "boolean"},
    "public_boundary": {"type": "string", "maxLength": 128},
    "ratio_computed_by_edge": {"type": "boolean"},
    "real_binary": {"type": "boolean"},
    "reason": {"type": "string", "maxLength": 512},
    "reason_code": {"type": "string", "maxLength": 128},
    "reconnect_attempts": {"type": "integer", "minimum": 0},
    "reconnect_elapsed_ms": {"type": "array", "maxItems": 128, "items": {"type": "integer", "minimum": 0}},
    "records": {"type": "integer", "minimum": 0},
    "recovered_without_fallback": {"type": "boolean"},
    "recovery_ack": {"type": "string", "maxLength": 128},
    "request_identity_stable": {"type": "boolean"},
    "resource_exhausted_responses": {"type": "integer", "minimum": 0},
    "result_batch_digest_stable": {"type": "boolean"},
    "result_order_reversed": {"type": "boolean"},
    "result_wal_bytes": {"type": "integer", "minimum": 0},
    "retained_bytes": {"type": "integer", "minimum": 0},
    "retained_records": {"type": "integer", "minimum": 0},
    "retry_ack_status": {"type": "string", "maxLength": 128},
    "retry_cycle_cooldown_ms": {"type": "integer", "minimum": 0},
    "retryable_grpc_codes": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}},
    "route_held": {"type": "boolean"},
    "rule_counts": {"type": "array", "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
    "same_ca_unlisted_leaf_rejected": {"type": "boolean"},
    "same_generation_attempt_budget": {"type": "integer", "minimum": 0},
    "same_generation_equivalent_worker_retry": {"type": "boolean"},
    "same_request_identity_after_recovery": {"type": "boolean"},
    "second_election_floor": {"type": "integer", "minimum": 0},
    "second_writer_or_session": {"type": "boolean"},
    "segment_count": {"type": "integer", "minimum": 0},
    "silent_hint_loss": {"type": "boolean"},
    "source_wal_record_limit": {"type": "integer", "minimum": 0},
    "stable_reason_codes": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
    "subsequent_preflight_recovered": {"type": "boolean"},
    "supplemental_source_semantics": {"type": "string", "maxLength": 256},
    "target_0_stream_opens": {"type": "integer", "minimum": 0},
    "target_1_stream_opens": {"type": "integer", "minimum": 0},
    "target_count": {"type": "integer", "minimum": 0},
    "target_profile_overcommitted": {"type": "boolean"},
    "timed_out_wal_retry_cycles": {"type": "integer", "minimum": 0},
    "tmpfs_bytes": {"type": "integer", "minimum": 0},
    "unacknowledged_overwrite": {"type": "boolean"},
    "unaffected_target_remained_connected": {"type": "boolean"},
    "unaffected_target_stream_opens": {"type": "integer", "minimum": 0},
    "unbounded_wait": {"type": "boolean"},
    "validated_ceilings": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}},
    "watermark_returned": {"type": "boolean"},
    "writes_before_exact_readback": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {"properties": {"qualification": {"const": "QUALIFIED"}}},
      "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
    },
    {
      "if": {"properties": {"level": {"const": "REHEARSAL"}}, "required": ["level"]},
      "then": {
        "properties": {
          "result": {"enum": ["HOLD", "FAIL", "NOT_RUN"]},
          "qualification": {"const": "NOT_QUALIFIED"}
        }
      }
    }
  ]
}
