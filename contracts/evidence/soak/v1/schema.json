{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/soak/v1/schema.json",
  "title": "QualificationSoakEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "module",
    "requirement_ids",
    "level",
    "applicability",
    "result",
    "qualification",
    "profile_digest",
    "claim_scope",
    "claim_scope_digest",
    "started_at",
    "finished_at",
    "monotonic_start_ns",
    "monotonic_end_ns",
    "warmup_elapsed_ms",
    "duration_target_ms",
    "qualified_elapsed_ms",
    "sample_interval_ms",
    "phases",
    "samples",
    "lease_renewals",
    "summary",
    "interruption",
    "cleanup",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "qualification-soak/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "module": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
    },
    "level": {"enum": ["REHEARSAL", "MODULE", "PAIRWISE", "SYSTEM_E2E", "PRODUCTION"]},
    "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
    "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "claim_scope": {"$ref": "#/$defs/claimScope"},
    "claim_scope_digest": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "monotonic_start_ns": {"type": "integer", "minimum": 0},
    "monotonic_end_ns": {"type": "integer", "minimum": 1},
    "warmup_elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 90000},
    "duration_target_ms": {"const": 3600000},
    "qualified_elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 3660000},
    "sample_interval_ms": {"type": "integer", "minimum": 1, "maximum": 10000},
    "phases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"name": {"const": "steady"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"name": {"const": "peak"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"name": {"const": "saturation"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"name": {"const": "recovery-or-activation"}}}]}
      ],
      "items": false
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {"$ref": "#/$defs/sample"}
    },
    "lease_renewals": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/leaseRenewal"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_count", "unclassified_gap_count", "oom_events", "container_restarts", "oracle_mismatches", "resource_limit_violations"],
      "properties": {
        "error_count": {"type": "integer", "minimum": 0},
        "unclassified_gap_count": {"type": "integer", "minimum": 0},
        "oom_events": {"type": "integer", "minimum": 0},
        "container_restarts": {"type": "integer", "minimum": 0},
        "oracle_mismatches": {"type": "integer", "minimum": 0},
        "resource_limit_violations": {"type": "integer", "minimum": 0},
        "module_metrics": {"$ref": "#/$defs/moduleMetrics"}
      }
    },
    "interruption": {"enum": ["NONE", "CANCEL", "TIMEOUT", "CRASH", "EVIDENCE_FAILURE"]},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "completed", "exit_code", "remaining_resources", "checks"],
      "properties": {
        "attempted": {"type": "boolean"},
        "completed": {"type": "boolean"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "remaining_resources": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 256}},
        "checks": {"$ref": "#/$defs/cleanupChecks"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "level": {"not": {"const": "REHEARSAL"}},
          "applicability": {"const": "APPLICABLE"},
          "qualification": {"const": "QUALIFIED"},
          "qualified_elapsed_ms": {"minimum": 3600000},
          "warmup_elapsed_ms": {"minimum": 60000, "maximum": 90000},
          "sample_interval_ms": {"const": 10000},
          "interruption": {"const": "NONE"},
          "summary": {
            "properties": {
              "error_count": {"const": 0},
              "unclassified_gap_count": {"const": 0},
              "oom_events": {"const": 0},
              "container_restarts": {"const": 0},
              "oracle_mismatches": {"const": 0},
              "resource_limit_violations": {"const": 0}
            }
          },
          "cleanup": {
            "properties": {
              "attempted": {"const": true},
              "completed": {"const": true},
              "exit_code": {"const": 0},
              "remaining_resources": {"maxItems": 0},
              "checks": {"$ref": "#/$defs/successfulCleanupChecks"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {"const": "MODULE"},
          "result": {"enum": ["PASS", "HOLD"]}
        },
        "required": ["level", "result"]
      },
      "then": {
        "properties": {
          "warmup_elapsed_ms": {"minimum": 60000, "maximum": 90000},
          "qualified_elapsed_ms": {"minimum": 3600000},
          "sample_interval_ms": {"const": 10000},
          "interruption": {"const": "NONE"},
          "phases": {
            "prefixItems": [
              {"allOf": [{"$ref": "#/$defs/formalPhase"}, {"properties": {"name": {"const": "steady"}}}]},
              {"allOf": [{"$ref": "#/$defs/formalPhase"}, {"properties": {"name": {"const": "peak"}}}]},
              {"allOf": [{"$ref": "#/$defs/formalPhase"}, {"properties": {"name": {"const": "saturation"}}}]},
              {"allOf": [{"$ref": "#/$defs/formalPhase"}, {"properties": {"name": {"const": "recovery-or-activation"}}}]}
            ]
          },
          "summary": {
            "properties": {
              "error_count": {"const": 0},
              "unclassified_gap_count": {"const": 0},
              "oom_events": {"const": 0},
              "container_restarts": {"const": 0},
              "oracle_mismatches": {"const": 0},
              "resource_limit_violations": {"const": 0},
              "module_metrics": {
                "required": ["formal_schedule_executed", "absolute_threshold_status", "warmup_actual_ms"],
                "properties": {
                  "formal_schedule_executed": {"const": true},
                  "absolute_threshold_status": {"type": "string", "minLength": 1},
                  "warmup_actual_ms": {"minimum": 60000, "maximum": 90000}
                }
              }
            }
          },
          "cleanup": {
            "properties": {
              "attempted": {"const": true},
              "completed": {"const": true},
              "exit_code": {"const": 0},
              "remaining_resources": {"maxItems": 0},
              "checks": {"$ref": "#/$defs/successfulCleanupChecks"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "module": {"const": "rust-edge-agent"},
          "level": {"const": "MODULE"},
          "result": {"enum": ["PASS", "HOLD"]}
        },
        "required": ["module", "level", "result"]
      },
      "then": {"properties": {"lease_renewals": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {
          "module": {"const": "central-inference"},
          "level": {"const": "MODULE"},
          "result": {"enum": ["PASS", "HOLD"]}
        },
        "required": ["module", "level", "result"]
      },
      "then": {"properties": {"lease_renewals": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {
          "module": {"const": "control-core"},
          "level": {"const": "MODULE"},
          "result": {"enum": ["PASS", "HOLD"]}
        },
        "required": ["module", "level", "result"]
      },
      "then": {"properties": {"lease_renewals": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"level": {"const": "REHEARSAL"}}, "required": ["level"]},
      "then": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cleanupChecks": {
      "oneOf": [
        {"$ref": "#/$defs/edgeCleanupChecks"},
        {"$ref": "#/$defs/genericCleanupChecks"}
      ]
    },
    "edgeCleanupChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_process_reaped",
        "p4_server_task_joined",
        "inference_server_task_joined",
        "control_server_task_joined",
        "p4_listener_released",
        "inference_listener_released",
        "control_listener_released"
      ],
      "properties": {
        "edge_process_reaped": {"type": "boolean"},
        "p4_server_task_joined": {"type": "boolean"},
        "inference_server_task_joined": {"type": "boolean"},
        "control_server_task_joined": {"type": "boolean"},
        "p4_listener_released": {"type": "boolean"},
        "inference_listener_released": {"type": "boolean"},
        "control_listener_released": {"type": "boolean"}
      }
    },
    "genericCleanupChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_process_reaped", "provider_tasks_joined", "listeners_released"],
      "properties": {
        "module_process_reaped": {"type": "boolean"},
        "provider_tasks_joined": {"type": "boolean"},
        "listeners_released": {"type": "boolean"}
      }
    },
    "successfulCleanupChecks": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/edgeCleanupChecks"},
            {
              "properties": {
                "edge_process_reaped": {"const": true},
                "p4_server_task_joined": {"const": true},
                "inference_server_task_joined": {"const": true},
                "control_server_task_joined": {"const": true},
                "p4_listener_released": {"const": true},
                "inference_listener_released": {"const": true},
                "control_listener_released": {"const": true}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/genericCleanupChecks"},
            {
              "properties": {
                "module_process_reaped": {"const": true},
                "provider_tasks_joined": {"const": true},
                "listeners_released": {"const": true}
              }
            }
          ]
        }
      ]
    },
    "leaseRenewal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset_ms",
        "observed_at_unix_ms",
        "previous_expires_at_unix_ms",
        "requested_expires_at_unix_ms",
        "target_id",
        "lease_id",
        "trace_id",
        "state",
        "reason_code",
        "actor_runtime_epoch"
      ],
      "properties": {
        "offset_ms": {"type": "integer", "minimum": 1, "maximum": 3660000},
        "observed_at_unix_ms": {"type": "integer", "minimum": 1},
        "previous_expires_at_unix_ms": {"type": "integer", "minimum": 1},
        "requested_expires_at_unix_ms": {"type": "integer", "minimum": 1},
        "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
        "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
        "trace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
        "state": {"const": "PRIMARY"},
        "reason_code": {"type": "string", "maxLength": 128},
        "actor_runtime_epoch": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_target_queue_depth",
        "source_wal_bytes",
        "input_wal_bytes",
        "result_wal_bytes",
        "rss_bytes",
        "fd_count",
        "thread_count",
        "process_threshold_status"
      ],
      "properties": {
        "aggregate_target_queue_depth": {"type": "integer", "minimum": 1, "maximum": 100000},
        "source_wal_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "input_wal_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "result_wal_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "rss_bytes": {"type": "null"},
        "fd_count": {"type": "null"},
        "thread_count": {"type": "null"},
        "process_threshold_status": {"const": "OBSERVED_ONLY_OWNER_NOT_FROZEN_DEC_001"}
      }
    },
    "claimScope": {
      "oneOf": [
        {"$ref": "#/$defs/edgeClaimScope"},
        {"$ref": "#/$defs/p4ClaimScope"},
        {"$ref": "#/$defs/inferenceClaimScope"},
        {"$ref": "#/$defs/controlClaimScope"}
      ]
    },
    "edgeClaimScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "scope", "rule_counts", "target_counts", "threshold_status", "resource_limits"],
      "properties": {
        "module": {"const": "rust-edge-agent"},
        "scope": {"const": "independent-module-soak"},
        "rule_counts": {
          "type": "array",
          "prefixItems": [{"const": 0}, {"const": 128}, {"const": 1024}, {"const": 4096}],
          "items": false
        },
        "target_counts": {
          "type": "array",
          "prefixItems": [{"const": 0}, {"const": 1}, {"const": 2}, {"const": "N"}],
          "items": false
        },
        "threshold_status": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource_limits": {"$ref": "#/$defs/resourceLimits"}
      }
    },
    "p4ClaimScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "scope", "rule_counts", "target_counts", "threshold_status"],
      "properties": {
        "module": {"const": "p4-switch"},
        "scope": {"const": "independent-module-soak"},
        "rule_counts": {
          "type": "array",
          "prefixItems": [{"const": 0}, {"const": 128}, {"const": 1024}, {"const": 4096}],
          "items": false
        },
        "target_counts": {
          "type": "array",
          "prefixItems": [{"const": 1}],
          "items": false
        },
        "threshold_status": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "inferenceClaimScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "scope", "batch_sizes", "runtime_profile", "availability_profile", "threshold_status", "resource_limits"],
      "properties": {
        "module": {"const": "central-inference"},
        "scope": {"const": "independent-module-soak"},
        "batch_sizes": {
          "type": "array",
          "prefixItems": [{"const": 1}, {"const": 32}, {"const": 128}, {"const": 256}],
          "items": false
        },
        "runtime_profile": {"const": "model-runtime-central-cpu/v1"},
        "availability_profile": {"const": "availability-single/v1"},
        "threshold_status": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource_limits": {"$ref": "#/$defs/inferenceResourceLimits"}
      }
    },
    "inferenceResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway_in_flight", "triton_queue_records", "max_batch_size", "rss_bytes", "fd_count", "thread_count", "process_threshold_status"],
      "properties": {
        "gateway_in_flight": {"type": "integer", "minimum": 1, "maximum": 256},
        "triton_queue_records": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_batch_size": {"const": 256},
        "rss_bytes": {"type": "null"},
        "fd_count": {"type": "null"},
        "thread_count": {"type": "null"},
        "process_threshold_status": {"const": "OBSERVED_ONLY_OWNER_NOT_FROZEN_DEC_001"}
      }
    },
    "controlClaimScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "scope", "rule_counts", "target_counts", "concurrency", "threshold_status", "resource_limits"],
      "properties": {
        "module": {"const": "control-core"},
        "scope": {"const": "independent-module-soak"},
        "rule_counts": {
          "type": "array",
          "prefixItems": [{"const": 0}, {"const": 128}, {"const": 1024}, {"const": 4096}],
          "items": false
        },
        "target_counts": {
          "type": "array",
          "prefixItems": [{"const": 0}, {"const": 1}, {"const": 2}, {"const": "N"}],
          "items": false
        },
        "concurrency": {
          "type": "array",
          "prefixItems": [{"const": 2}, {"const": 8}, {"const": 32}, {"const": 128}],
          "items": false
        },
        "threshold_status": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource_limits": {"$ref": "#/$defs/controlResourceLimits"}
      }
    },
    "controlResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pg_connections", "pool_size", "queue_depth", "transaction_bytes", "wal_bytes", "rss_bytes", "fd_count", "thread_count", "process_threshold_status"],
      "properties": {
        "pg_connections": {"type": "integer", "minimum": 1, "maximum": 1024},
        "pool_size": {"type": "integer", "minimum": 1, "maximum": 256},
        "queue_depth": {"type": "integer", "minimum": 1, "maximum": 100000},
        "transaction_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "wal_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "rss_bytes": {"type": "null"},
        "fd_count": {"type": "null"},
        "thread_count": {"type": "null"},
        "process_threshold_status": {"const": "OBSERVED_ONLY_OWNER_NOT_FROZEN_DEC_001"}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "planned_ms", "elapsed_ms", "result", "requested_rate_pps", "achieved_rate_pps", "errors"],
      "properties": {
        "name": {"type": "string"},
        "planned_ms": {"const": 900000},
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 930000},
        "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
        "requested_rate_pps": {"type": "number", "minimum": 0},
        "achieved_rate_pps": {"type": "number", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "module_metrics": {"$ref": "#/$defs/moduleMetrics"}
      }
    },
    "formalPhase": {
      "allOf": [
        {"$ref": "#/$defs/phase"},
        {
          "type": "object",
          "required": ["module_metrics"],
          "properties": {
            "elapsed_ms": {"minimum": 900000},
            "result": {"const": "PASS"},
            "errors": {"const": 0},
            "module_metrics": {
              "required": ["phase_start_offset_ms", "phase_end_offset_ms", "planned_duration_met"],
              "properties": {
                "phase_start_offset_ms": {"type": "integer", "minimum": 0},
                "phase_end_offset_ms": {"type": "integer", "minimum": 1},
                "planned_duration_met": {"const": true}
              }
            }
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_ms", "phase", "quality", "cpu_pct", "rss_bytes", "fd_count", "thread_count", "queue_depth", "oom_events", "container_restarts", "oracle_errors", "gap_count"],
      "properties": {
        "offset_ms": {"type": "integer", "minimum": 0, "maximum": 3660000},
        "phase": {"enum": ["warmup", "steady", "peak", "saturation", "recovery-or-activation", "cleanup"]},
        "quality": {"enum": ["valid", "gap", "not_measurable"]},
        "cpu_pct": {"type": "number", "minimum": 0, "maximum": 100000},
        "rss_bytes": {"type": "integer", "minimum": 0},
        "fd_count": {"type": "integer", "minimum": 0},
        "thread_count": {"type": "integer", "minimum": 0},
        "queue_depth": {"type": "integer", "minimum": 0},
        "oom_events": {"type": "integer", "minimum": 0},
        "container_restarts": {"type": "integer", "minimum": 0},
        "oracle_errors": {"type": "integer", "minimum": 0},
        "gap_count": {"type": "integer", "minimum": 0},
        "module_metrics": {"$ref": "#/$defs/moduleMetrics"}
      }
    },
    "moduleMetrics": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}
    }
  }
}
