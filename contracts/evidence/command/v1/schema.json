{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/command/v1/schema.json",
  "title": "RustEdgeCommandExecutionEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command_id",
    "started_at",
    "finished_at",
    "duration_ms",
    "working_directory",
    "argv",
    "exit_code",
    "result",
    "qualification",
    "source_tree_digest",
    "working_tree_status_digest",
    "log"
  ],
  "properties": {
    "schema_version": {"const": "edge-command-execution/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "command_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "working_directory": {"const": "edge-rs"},
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string", "maxLength": 4096}
    },
    "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "source_tree_digest": {"$ref": "#/$defs/digest"},
    "working_tree_status_digest": {"$ref": "#/$defs/digest"},
    "stable_reason": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "media_type"],
      "properties": {
        "path": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}\\.log$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "media_type": {"const": "text/plain"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "exit_code": {"const": 0},
          "qualification": {"const": "QUALIFIED"},
          "stable_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "HOLD"}}, "required": ["result"]},
      "then": {
        "properties": {
          "exit_code": {"const": 2},
          "qualification": {"const": "NOT_QUALIFIED"},
          "stable_reason": {"const": "COMMAND_EXITED_HOLD"}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]},
      "then": {
        "properties": {
          "exit_code": {"type": "integer", "minimum": 1, "not": {"const": 2}},
          "qualification": {"const": "NOT_QUALIFIED"},
          "stable_reason": {"const": "COMMAND_EXITED_FAILURE"}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "NOT_RUN"}}, "required": ["result"]},
      "then": {
        "properties": {
          "exit_code": {"type": "null"},
          "qualification": {"const": "NOT_QUALIFIED"},
          "stable_reason": {"type": "string"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
