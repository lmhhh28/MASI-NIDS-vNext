{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/central-inference-oci/v1/schema.json",
  "title": "Central Inference OCI startup evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "test_id", "requirement_ids", "level", "applicability",
    "generated_at", "result", "qualification", "qualification_reason",
    "overall_module_complete", "source_revision", "source_tree_digest",
    "working_tree_dirty", "working_tree_status_digest", "checks"
  ],
  "properties": {
    "schema_version": {"const": "central-inference-oci-startup-evidence/v1"},
    "test_id": {"const": "TEST-INF-OCI-001"},
    "requirement_ids": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"}
    },
    "level": {"const": "MODULE"},
    "applicability": {"const": "APPLICABLE"},
    "generated_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["PASS", "HOLD", "FAIL", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "qualification_reason": {
      "enum": ["CLEAN_SOURCE_SNAPSHOT", "DIRTY_WORKTREE_NOT_RELEASE_BASELINE", "OCI_GATE_EXPLICITLY_SKIPPED", "OCI_STARTUP_FAILED"]
    },
    "scope": {"type": "string", "minLength": 1, "maxLength": 512},
    "overall_module_complete": {"const": false},
    "image_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "image_manifest_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "image_config_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "image_binary_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "gateway_binary_digest": {"$ref": "#/$defs/sha256"},
    "probe_binary_digest": {"$ref": "#/$defs/sha256"},
    "image_archive_digest": {"$ref": "#/$defs/sha256"},
    "triton_image": {"type": "string", "pattern": "^[^@]+@sha256:(?!0{64}$)[0-9a-f]{64}$", "maxLength": 512},
    "triton_server_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "probe_certificate_digest": {"$ref": "#/$defs/sha256"},
    "image_user": {"const": "65532:65532"},
    "source_revision": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "source_tree_digest": {"$ref": "#/$defs/sha256"},
    "working_tree_dirty": {"type": "boolean"},
    "working_tree_status_digest": {"$ref": "#/$defs/sha256"},
    "config_digest": {"$ref": "#/$defs/sha256"},
    "read_only_rootfs": {"type": ["boolean", "null"]},
    "cap_drop": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}},
    "security_options": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}},
    "pids_limit": {"type": "integer", "minimum": 1},
    "memory_bytes": {"type": "integer", "minimum": 1},
    "nano_cpus": {"type": "integer", "minimum": 1},
    "tmpfs": {"type": "object", "minProperties": 1, "maxProperties": 8, "additionalProperties": {"type": "string", "maxLength": 256}},
    "graceful_shutdown_exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image_source_labels": {"const": "PASS"},
        "non_root_user": {"const": "PASS"},
        "read_only_rootfs": {"const": "PASS"},
        "capability_drop_all": {"const": "PASS"},
        "no_new_privileges": {"const": "PASS"},
        "bounded_pids_memory_cpu_tmpfs": {"const": "PASS"},
        "real_triton_sidecar_mtls": {"const": "PASS"},
        "real_triton_startup": {"const": "PASS"},
        "public_mtls_probe": {"const": "PASS"},
        "graceful_sigterm": {"const": "PASS"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"enum": ["PASS", "HOLD"]}}, "required": ["result"]},
      "then": {
        "required": [
          "scope", "image_ref", "image_manifest_digest", "image_config_digest", "gateway_binary_digest",
          "probe_binary_digest", "image_archive_digest", "triton_image", "triton_server_version",
          "probe_certificate_digest", "image_user", "config_digest", "read_only_rootfs", "cap_drop",
          "security_options", "pids_limit", "memory_bytes", "nano_cpus", "tmpfs", "graceful_shutdown_exit_code"
        ],
        "properties": {
          "read_only_rootfs": {"const": true},
          "graceful_shutdown_exit_code": {"const": 0},
          "checks": {
            "required": [
              "image_source_labels", "non_root_user", "read_only_rootfs", "capability_drop_all",
              "no_new_privileges", "bounded_pids_memory_cpu_tmpfs", "real_triton_sidecar_mtls",
              "real_triton_startup", "public_mtls_probe", "graceful_sigterm"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {"properties": {"qualification": {"const": "QUALIFIED"}, "working_tree_dirty": {"const": false}, "qualification_reason": {"const": "CLEAN_SOURCE_SNAPSHOT"}}}
    },
    {
      "if": {"properties": {"result": {"const": "HOLD"}}, "required": ["result"]},
      "then": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}, "working_tree_dirty": {"const": true}, "qualification_reason": {"const": "DIRTY_WORKTREE_NOT_RELEASE_BASELINE"}}}
    },
    {
      "if": {"properties": {"result": {"const": "NOT_RUN"}}, "required": ["result"]},
      "then": {
        "required": ["image_manifest_digest", "image_config_digest", "image_binary_digest", "read_only_rootfs", "graceful_shutdown_exit_code"],
        "properties": {
          "qualification": {"const": "NOT_QUALIFIED"},
          "qualification_reason": {"const": "OCI_GATE_EXPLICITLY_SKIPPED"},
          "image_manifest_digest": {"type": "null"},
          "image_config_digest": {"type": "null"},
          "image_binary_digest": {"type": "null"},
          "read_only_rootfs": {"type": "null"},
          "graceful_shutdown_exit_code": {"type": "null"},
          "checks": {"maxProperties": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
  }
}
