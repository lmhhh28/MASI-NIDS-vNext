{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/edge-central-control-pairwise-rehearsal/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "started_at", "finished_at", "participants", "real_boundaries", "fixtures", "triton_statistics", "edge_evidence", "event_evidence", "central_oci_result", "process_logs", "level", "applicability", "result", "qualification", "qualification_scope"],
  "properties": {
    "schema_version": {"const": "edge-central-control-pairwise-rehearsal/v1"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "participants": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_binary_digest", "gateway_image_manifest_digest", "triton_image_digest", "startup_envelope_digest", "control_binary_digest"],
      "properties": {
        "edge_binary_digest": {"$ref": "#/$defs/digest"}, "gateway_image_manifest_digest": {"$ref": "#/$defs/digest"},
        "triton_image_digest": {"$ref": "#/$defs/digest"}, "startup_envelope_digest": {"$ref": "#/$defs/digest"},
        "control_binary_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "real_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_gateway_get_binding", "edge_gateway_infer", "gateway_triton_model_infer", "edge_control_sink_mtls", "control_postgresql_event_commit", "postgresql_commit_edge_ack"],
      "properties": {
        "edge_gateway_get_binding": {"const": true}, "edge_gateway_infer": {"const": true}, "gateway_triton_model_infer": {"const": true},
        "edge_control_sink_mtls": {"const": true}, "control_postgresql_event_commit": {"const": true}, "postgresql_commit_edge_ack": {"const": true}
      }
    },
    "fixtures": {"type": "object", "additionalProperties": false, "required": ["p4runtime"], "properties": {"p4runtime": {"const": "deterministic-mtls-fake"}}},
    "triton_statistics": {"type": "object", "required": ["inference_count_before", "inference_count_after", "inference_count_delta"], "properties": {"inference_count_before": {"type": "integer", "minimum": 0}, "inference_count_after": {"type": "integer", "minimum": 1}, "inference_count_delta": {"type": "integer", "minimum": 1}}},
    "edge_evidence": {"type": "object", "required": ["schema_version", "canonical_commit_batches", "control_sink_kind", "fake_inference_calls", "result"], "properties": {"schema_version": {"const": "edge-real-central-pairwise-rehearsal/v1"}, "canonical_commit_batches": {"type": "integer", "minimum": 1}, "control_sink_kind": {"const": "real-go-postgresql"}, "fake_inference_calls": {"const": 0}, "result": {"const": "PASS"}}},
    "event_evidence": {"type": "object", "required": ["schema_version", "event_id", "event_idempotency_key", "input_digest", "output_digest", "worker_id", "worker_digest", "commit_status", "event_count", "incident_count"], "properties": {"schema_version": {"const": "go-event-commit-observation/v1"}, "event_id": {"type": "string", "minLength": 1}, "event_idempotency_key": {"type": "string", "minLength": 1}, "input_digest": {"$ref": "#/$defs/digest"}, "output_digest": {"$ref": "#/$defs/digest"}, "worker_id": {"type": "string", "minLength": 1}, "worker_digest": {"$ref": "#/$defs/digest"}, "commit_status": {"const": "committed"}, "event_count": {"const": 1}, "incident_count": {"type": "integer", "minimum": 0, "maximum": 1}}},
    "central_oci_result": {"enum": ["PASS", "HOLD"]},
    "process_logs": {"type": "object", "additionalProperties": false, "required": ["edge", "central", "gateway", "triton", "control"], "properties": {"edge": {"$ref": "#/$defs/digest"}, "central": {"$ref": "#/$defs/digest"}, "gateway": {"$ref": "#/$defs/digest"}, "triton": {"$ref": "#/$defs/digest"}, "control": {"$ref": "#/$defs/digest"}}},
    "level": {"const": "REHEARSAL"}, "applicability": {"const": "APPLICABLE"}, "result": {"const": "PASS"}, "qualification": {"const": "NOT_QUALIFIED"},
    "qualification_scope": {"type": "string", "minLength": 1, "maxLength": 512}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
