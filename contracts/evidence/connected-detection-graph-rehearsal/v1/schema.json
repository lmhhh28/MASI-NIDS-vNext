{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/connected-detection-graph-rehearsal/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_revision", "source_tree_digest", "working_tree_dirty", "working_tree_status_digest", "started_at", "finished_at", "participants", "real_boundaries", "fixtures", "pipeline_loader", "traffic", "triton_statistics", "edge_evidence", "event_evidence", "central_oci_result", "process_logs", "cleanup", "level", "applicability", "result", "qualification", "qualification_scope"],
  "properties": {
    "schema_version": {"const": "connected-detection-graph-rehearsal/v1"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "source_revision": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "source_tree_digest": {"$ref": "#/$defs/digest"},
    "working_tree_dirty": {"type": "boolean"},
    "working_tree_status_digest": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "participants": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_binary_digest", "gateway_image_manifest_digest", "triton_image_digest", "startup_envelope_digest", "control_binary_digest", "bmv2_image_digest", "p4_source_digest", "bmv2_json_digest"],
      "properties": {
        "edge_binary_digest": {"$ref": "#/$defs/digest"}, "gateway_image_manifest_digest": {"$ref": "#/$defs/digest"},
        "triton_image_digest": {"$ref": "#/$defs/digest"}, "startup_envelope_digest": {"$ref": "#/$defs/digest"},
        "control_binary_digest": {"$ref": "#/$defs/digest"}, "bmv2_image_digest": {"$ref": "#/$defs/digest"},
        "p4_source_digest": {"$ref": "#/$defs/digest"}, "bmv2_json_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "real_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["bmv2_edge_p4runtime_mtls", "edge_streamchannel_mastership", "edge_gateway_infer_mtls", "gateway_triton_model_infer", "edge_control_sink_mtls", "control_postgresql_event_commit", "postgresql_commit_edge_ack"],
      "properties": {
        "bmv2_edge_p4runtime_mtls": {"const": true}, "edge_streamchannel_mastership": {"const": true},
        "edge_gateway_infer_mtls": {"const": true}, "gateway_triton_model_infer": {"const": true},
        "edge_control_sink_mtls": {"const": true}, "control_postgresql_event_commit": {"const": true},
        "postgresql_commit_edge_ack": {"const": true}
      }
    },
    "fixtures": {"type": "object", "additionalProperties": false, "required": ["pipeline_loader", "traffic_sender"], "properties": {"pipeline_loader": {"const": "isolated-one-shot-closed-before-edge"}, "traffic_sender": {"const": "packet-only-no-p4runtime-credentials"}}},
    "pipeline_loader": {"type": "object", "required": ["schema_version", "loader_closed_before_edge", "p4runtime_api_version", "p4info_digest", "device_config_digest", "cookie"], "properties": {"loader_closed_before_edge": {"const": true}}},
    "traffic": {"type": "object", "required": ["schema_version", "packet_count", "peer_packet_count", "p4runtime_credentials_present"], "properties": {"schema_version": {"const": "bmv2-traffic-sender/v1"}, "packet_count": {"const": 64}, "peer_packet_count": {"type": "integer", "minimum": 64}, "p4runtime_credentials_present": {"const": false}}},
    "triton_statistics": {"type": "object", "required": ["inference_count_before", "inference_count_after", "inference_count_delta"], "properties": {"inference_count_before": {"type": "integer", "minimum": 0}, "inference_count_after": {"type": "integer", "minimum": 1}, "inference_count_delta": {"type": "integer", "minimum": 1}}},
    "edge_evidence": {"type": "object", "required": ["schema_version", "p4runtime_kind", "control_sink_kind", "fake_p4_stream_opens", "fake_inference_calls", "traffic_packets", "canonical_commit_batches", "result"], "properties": {"schema_version": {"const": "edge-real-central-pairwise-rehearsal/v1"}, "p4runtime_kind": {"const": "real-bmv2"}, "control_sink_kind": {"const": "real-go-postgresql"}, "fake_p4_stream_opens": {"const": 0}, "fake_inference_calls": {"const": 0}, "traffic_packets": {"const": 64}, "canonical_commit_batches": {"type": "integer", "minimum": 1}, "result": {"const": "PASS"}}},
    "event_evidence": {"type": "object", "required": ["schema_version", "event_id", "event_idempotency_key", "input_digest", "output_digest", "worker_id", "worker_digest", "commit_status", "event_count", "incident_count"], "properties": {"schema_version": {"const": "go-event-commit-observation/v1"}, "event_id": {"type": "string", "minLength": 1}, "event_idempotency_key": {"type": "string", "minLength": 1}, "input_digest": {"$ref": "#/$defs/digest"}, "output_digest": {"$ref": "#/$defs/digest"}, "worker_id": {"type": "string", "minLength": 1}, "worker_digest": {"$ref": "#/$defs/digest"}, "commit_status": {"const": "committed"}, "event_count": {"const": 1}, "incident_count": {"type": "integer", "minimum": 0, "maximum": 1}}},
    "central_oci_result": {"enum": ["PASS", "HOLD"]},
    "process_logs": {"type": "object", "additionalProperties": false, "required": ["edge", "central", "gateway", "triton", "control", "bmv2", "p4_compiler", "p4_loader", "p4_traffic"], "properties": {"edge": {"$ref": "#/$defs/digest"}, "central": {"$ref": "#/$defs/digest"}, "gateway": {"$ref": "#/$defs/digest"}, "triton": {"$ref": "#/$defs/digest"}, "control": {"$ref": "#/$defs/digest"}, "bmv2": {"$ref": "#/$defs/digest"}, "p4_compiler": {"$ref": "#/$defs/digest"}, "p4_loader": {"$ref": "#/$defs/digest"}, "p4_traffic": {"$ref": "#/$defs/digest"}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["attempted", "result", "commands", "remaining_resources", "processes_reaped_or_not_started"], "properties": {"attempted": {"const": true}, "result": {"const": "PASS"}, "commands": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["name", "exit_code", "output_tail"], "properties": {"name": {"enum": ["postgresql-compose", "p4-compose"]}, "exit_code": {"const": 0}, "output_tail": {"type": "string", "maxLength": 1024}}}}, "remaining_resources": {"type": "array", "maxItems": 0}, "processes_reaped_or_not_started": {"type": "object", "additionalProperties": false, "required": ["edge", "central", "control", "plugin_sideplane", "analysis_sideplane", "observer"], "properties": {"edge": {"const": true}, "central": {"const": true}, "control": {"const": true}, "plugin_sideplane": {"const": true}, "analysis_sideplane": {"const": true}, "observer": {"const": true}}}}},
    "level": {"const": "REHEARSAL"}, "applicability": {"const": "APPLICABLE"}, "result": {"const": "PASS"}, "qualification": {"const": "NOT_QUALIFIED"},
    "qualification_scope": {"type": "string", "minLength": 1, "maxLength": 512}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}}
}
