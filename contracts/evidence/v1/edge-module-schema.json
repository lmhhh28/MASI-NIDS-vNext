{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/v1/edge-module-schema.json",
  "title": "Rust Edge Agent module evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "requirement_ids",
    "level",
    "applicability",
    "result",
    "qualification",
    "source_revision",
    "source_tree_digest",
    "working_tree_dirty",
    "overall_module_complete"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "edge-oci-startup-evidence/v1",
        "edge-deep-check-evidence/v1",
        "rust-edge-agent-supply-verification/v1",
        "edge-module-gate-summary/v1"
      ]
    },
    "test_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"}
    },
    "level": {"const": "MODULE"},
    "applicability": {"const": "APPLICABLE"},
    "result": {"enum": ["PASS", "HOLD", "FAIL", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_digest": {"$ref": "#/$defs/sha256"},
    "working_tree_dirty": {"type": "boolean"},
    "working_tree_status_digest": {"$ref": "#/$defs/sha256"},
    "overall_module_complete": {"type": "boolean"},
    "artifact_digests": {
      "oneOf": [
        {"$ref": "#/$defs/moduleArtifactDigests"},
        {"$ref": "#/$defs/deepArtifactDigests"},
        {"$ref": "#/$defs/emptyObject"}
      ]
    },
    "archive": {"$ref": "#/$defs/ociArchiveInspection"},
    "baseline_git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "cap_drop": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}},
    "checks": {
      "anyOf": [
        {"$ref": "#/$defs/ociChecks"},
        {"$ref": "#/$defs/deepChecks"},
        {"$ref": "#/$defs/supplyChecks"},
        {"$ref": "#/$defs/supplyFailureChecks"},
        {"$ref": "#/$defs/emptyObject"}
      ]
    },
    "conditional_applicability": {"$ref": "#/$defs/frozenConditionalApplicability"},
    "completion": {"$ref": "#/$defs/moduleCompletion"},
    "config_digest": {"$ref": "#/$defs/sha256"},
    "executed_gates": {"$ref": "#/$defs/executedGates"},
    "failure_reasons": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 512}},
    "generated_at": {"type": "string", "format": "date-time"},
    "graceful_shutdown_exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "hold_reasons": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 512}},
    "image_binary_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "image_config_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "image_manifest_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "image_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "image_user": {"type": "string", "minLength": 1, "maxLength": 128},
    "manifest_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "memory_bytes": {"type": "integer", "minimum": 1},
    "module_id": {"const": "MOD-EDGE-001"},
    "nano_cpus": {"type": "integer", "minimum": 1},
    "negative_verification": {"$ref": "#/$defs/negativeVerification"},
    "nightly_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "offline_rebuild_digest": {"$ref": "#/$defs/sha256"},
    "overall_status": {"enum": ["PASS", "HOLD", "FAIL", "NOT_RUN"]},
    "pids_limit": {"type": "integer", "minimum": 1},
    "probe": {"$ref": "#/$defs/ociProbe"},
    "public_boundary_blackbox_coverage": {"type": "string", "minLength": 1, "maxLength": 512},
    "qualification_gates": {"$ref": "#/$defs/qualificationGates"},
    "qualification_reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "read_only_rootfs": {"type": ["boolean", "null"]},
    "registry_digest": {"$ref": "#/$defs/sha256"},
    "requirement_traceability": {"$ref": "#/$defs/requirementTraceability"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "sboms": {"$ref": "#/$defs/sboms"},
    "scope": {"type": "string", "minLength": 1, "maxLength": 512},
    "security_options": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}},
    "signature_bundle_digest": {"$ref": "#/$defs/sha256"},
    "target_triple": {"type": "string", "minLength": 1, "maxLength": 128},
    "tmpfs": {"const": {"/tmp": "rw,noexec,nosuid,size=16m"}},
    "trivy": {"$ref": "#/$defs/trivy"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {"properties": {"qualification": {"const": "QUALIFIED"}}},
      "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
    },
    {
      "if": {
        "properties": {
          "working_tree_dirty": {"const": true},
          "result": {"not": {"const": "NOT_RUN"}}
        },
        "required": ["working_tree_dirty", "result"]
      },
      "then": {
        "properties": {
          "result": {"enum": ["HOLD", "FAIL"]},
          "qualification": {"const": "NOT_QUALIFIED"}
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "edge-oci-startup-evidence/v1"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "generated_at",
          "qualification_reason",
          "checks",
          "image_manifest_digest",
          "image_config_digest",
          "image_binary_digest",
          "read_only_rootfs",
          "graceful_shutdown_exit_code"
        ],
        "properties": {
          "test_id": {"const": "TEST-EDGE-OCI-001"},
          "requirement_ids": {"const": ["MOD-EDGE-001", "TEST-003", "TEST-010", "TEST-REAL-E2E-001"]}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "NOT_RUN"}}, "required": ["result"]},
            "then": {
              "properties": {
                "qualification_reason": {"const": "OCI_GATE_EXPLICITLY_SKIPPED"},
                "checks": {"$ref": "#/$defs/emptyObject"},
                "image_manifest_digest": {"type": "null"},
                "image_config_digest": {"type": "null"},
                "image_binary_digest": {"type": "null"},
                "read_only_rootfs": {"type": "null"},
                "graceful_shutdown_exit_code": {"type": "null"}
              }
            },
            "else": {
              "required": ["scope", "archive", "probe", "image_ref", "image_user", "config_digest", "cap_drop", "security_options", "pids_limit", "memory_bytes", "nano_cpus", "tmpfs"],
              "properties": {
                "scope": {"const": "OCI startup, mTLS public-boundary liveness, and graceful SIGTERM only"},
                "checks": {"$ref": "#/$defs/ociChecks"},
                "image_manifest_digest": {"$ref": "#/$defs/sha256"},
                "image_config_digest": {"$ref": "#/$defs/sha256"},
                "image_binary_digest": {"$ref": "#/$defs/sha256"},
                "image_user": {"const": "65532:65532"},
                "read_only_rootfs": {"const": true},
                "cap_drop": {"const": ["ALL"]},
                "security_options": {"const": ["no-new-privileges:true"]},
                "pids_limit": {"const": 128},
                "memory_bytes": {"const": 268435456},
                "nano_cpus": {"const": 1000000000},
                "graceful_shutdown_exit_code": {"const": 0}
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "edge-deep-check-evidence/v1"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["generated_at", "qualification_reason", "artifact_digests", "checks"],
        "properties": {
          "test_id": {"const": "TEST-EDGE-RUST-DEEP-001"},
          "requirement_ids": {"const": ["MOD-EDGE-001", "TEST-003", "TEST-007", "TEST-009"]}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "NOT_RUN"}}, "required": ["result"]},
            "then": {
              "properties": {
                "qualification_reason": {"const": "DEEP_GATE_EXPLICITLY_SKIPPED"},
                "artifact_digests": {"$ref": "#/$defs/emptyObject"},
                "checks": {"$ref": "#/$defs/emptyObject"}
              }
            },
            "else": {
              "required": ["scope", "nightly_commit", "target_triple", "public_boundary_blackbox_coverage"],
              "properties": {
                "scope": {"const": "Rust library unit state-space under Miri, AddressSanitizer, and ThreadSanitizer"},
                "nightly_commit": {"const": "c98d0cb27cc63afdd62602a52eb4feb8a1c682dd"},
                "target_triple": {"const": "x86_64-unknown-linux-gnu"},
                "artifact_digests": {"$ref": "#/$defs/deepArtifactDigests"},
                "checks": {"$ref": "#/$defs/deepChecks"},
                "public_boundary_blackbox_coverage": {"const": "recorded separately by run-module-gates.sh"}
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "rust-edge-agent-supply-verification/v1"}
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["run_id", "manifest_digest", "checks", "failure_reasons", "hold_reasons"],
        "properties": {
          "test_id": {"const": "SEC-SUPPLY-001"},
          "requirement_ids": {"const": ["MOD-EDGE-001", "ARCH-REUSE-001", "SEC-SUPPLY-001", "TEST-010"]}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "NOT_RUN"}}, "required": ["result"]},
            "then": {
              "properties": {
                "manifest_digest": {"type": "null"},
                "checks": {"$ref": "#/$defs/emptyObject"},
                "hold_reasons": {"const": ["SUPPLY_GATE_EXPLICITLY_SKIPPED"]}
              }
            },
            "else": {
              "allOf": [
                {
                  "if": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]},
                  "then": {
                    "properties": {
                      "checks": {"$ref": "#/$defs/supplyFailureChecks"},
                      "failure_reasons": {"minItems": 1}
                    }
                  },
                  "else": {
                    "required": ["registry_digest", "negative_verification", "sboms", "signature_bundle_digest", "trivy"],
                    "properties": {
                      "manifest_digest": {"$ref": "#/$defs/sha256"},
                      "checks": {"$ref": "#/$defs/supplyChecks"},
                      "failure_reasons": {"maxItems": 0}
                    },
                    "allOf": [
                      {
                        "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
                        "then": {"properties": {"hold_reasons": {"maxItems": 0}}},
                        "else": {"properties": {"hold_reasons": {"minItems": 1}}}
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "edge-module-gate-summary/v1"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "run_id",
          "generated_at",
          "artifact_digests",
          "executed_gates",
          "qualification_gates",
          "requirement_traceability",
          "module_id",
          "baseline_git_tree",
          "working_tree_status_digest",
          "conditional_applicability",
          "completion",
          "overall_status"
        ],
        "properties": {
          "test_id": {"const": "TEST-EDGE-MODULE-GATES-001"},
          "requirement_ids": {"const": ["MOD-EDGE-001", "ARCH-003", "ARCH-004", "ARCH-TELEMETRY-001", "ARCH-TARGET-FLEET-001", "REL-TARGET-FLEET-001", "CONTRACT-P4-001", "CONTRACT-P4-FW-001", "CONTRACT-RULE-001", "CONTRACT-TARGET-001", "CONTRACT-TELEMETRY-001", "CONTRACT-INFERENCE-001", "CONTRACT-MODEL-001", "FUNC-EFFECT-001", "FUNC-TEL-001", "TEST-003", "TEST-007", "TEST-008", "TEST-009", "TEST-010", "TEST-RULE-001", "TEST-P4-FW-001", "TEST-TARGET-FLEET-001", "TEST-TEL-INF-001", "TEST-REAL-E2E-001", "DEC-044"]},
          "result": {"enum": ["PASS", "HOLD", "FAIL"]},
          "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
          "artifact_digests": {"$ref": "#/$defs/moduleArtifactDigests"},
          "executed_gates": {"$ref": "#/$defs/executedGates"},
          "conditional_applicability": {"$ref": "#/$defs/frozenConditionalApplicability"},
          "qualification_gates": {"$ref": "#/$defs/qualificationGates"},
          "requirement_traceability": {"$ref": "#/$defs/requirementTraceability"},
          "completion": {"$ref": "#/$defs/moduleCompletion"},
          "overall_status": {"enum": ["PASS", "HOLD", "FAIL"]}
        },
        "allOf": [
          {
            "if": {"properties": {"overall_status": {"enum": ["PASS", "HOLD"]}}, "required": ["overall_status"]},
            "then": {
              "properties": {
                "artifact_digests": {"$ref": "#/$defs/completeModuleArtifactDigests"}
              }
            },
            "else": {"properties": {"result": {"const": "FAIL"}}}
          },
          {
            "if": {"properties": {"overall_status": {"const": "PASS"}}, "required": ["overall_status"]},
            "then": {"properties": {"result": {"const": "PASS"}}},
            "else": {
              "if": {"properties": {"overall_status": {"const": "HOLD"}}, "required": ["overall_status"]},
              "then": {"properties": {"result": {"const": "HOLD"}}}
            }
          },
          {
            "if": {"properties": {"overall_module_complete": {"const": true}}, "required": ["overall_module_complete"]},
            "then": {"properties": {"completion": {"$ref": "#/$defs/completeModuleCompletion"}}},
            "else": {"properties": {"completion": {"properties": {"status": {"const": "INCOMPLETE"}}}}}
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "emptyObject": {"type": "object", "maxProperties": 0},
    "status": {"enum": ["PASS", "HOLD", "FAIL", "NOT_RUN"]},
    "moduleArtifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_lock", "edge_contract", "inference_contract", "inference_wire_profile", "edge_evidence_schema", "module_findings_schema", "module_findings_registry", "error_contract", "target_contract", "telemetry_contract", "qualification_profile", "soak_profile", "traceability_manifest", "traceability_evidence", "requirements_baseline", "release_binary", "oci_evidence", "deep_check_evidence", "supply_chain_evidence"],
      "properties": {
        "cargo_lock": {"$ref": "#/$defs/sha256"},
        "edge_contract": {"$ref": "#/$defs/sha256"},
        "inference_contract": {"$ref": "#/$defs/sha256"},
        "inference_wire_profile": {"$ref": "#/$defs/sha256"},
        "edge_evidence_schema": {"$ref": "#/$defs/sha256"},
        "module_findings_schema": {"$ref": "#/$defs/sha256"},
        "module_findings_registry": {"$ref": "#/$defs/sha256"},
        "error_contract": {"$ref": "#/$defs/sha256"},
        "target_contract": {"$ref": "#/$defs/sha256"},
        "telemetry_contract": {"$ref": "#/$defs/sha256"},
        "qualification_profile": {"$ref": "#/$defs/sha256"},
        "soak_profile": {"$ref": "#/$defs/sha256"},
        "traceability_manifest": {"$ref": "#/$defs/sha256"},
        "traceability_evidence": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "requirements_baseline": {"$ref": "#/$defs/sha256"},
        "release_binary": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "oci_evidence": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "deep_check_evidence": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "supply_chain_evidence": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "completeModuleArtifactDigests": {
      "allOf": [
        {"$ref": "#/$defs/moduleArtifactDigests"},
        {
          "properties": {
            "traceability_evidence": {"$ref": "#/$defs/sha256"},
            "release_binary": {"$ref": "#/$defs/sha256"},
            "oci_evidence": {"$ref": "#/$defs/sha256"},
            "deep_check_evidence": {"$ref": "#/$defs/sha256"},
            "supply_chain_evidence": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "completionStatus": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "completionCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_contracts",
        "format_lint_static",
        "unit_property_contract",
        "release_binary",
        "real_binary_public_boundary",
        "os_fault_recovery",
        "real_oci_startup",
        "deep_runtime_checks",
        "supply_security_checks",
        "formal_soak",
        "traceability",
        "known_p0_zero"
      ],
      "properties": {
        "public_contracts": {"$ref": "#/$defs/completionStatus"},
        "format_lint_static": {"$ref": "#/$defs/completionStatus"},
        "unit_property_contract": {"$ref": "#/$defs/completionStatus"},
        "release_binary": {"$ref": "#/$defs/completionStatus"},
        "real_binary_public_boundary": {"$ref": "#/$defs/completionStatus"},
        "os_fault_recovery": {"$ref": "#/$defs/completionStatus"},
        "real_oci_startup": {"$ref": "#/$defs/completionStatus"},
        "deep_runtime_checks": {"$ref": "#/$defs/completionStatus"},
        "supply_security_checks": {"$ref": "#/$defs/completionStatus"},
        "formal_soak": {"$ref": "#/$defs/completionStatus"},
        "traceability": {"$ref": "#/$defs/completionStatus"},
        "known_p0_zero": {"$ref": "#/$defs/completionStatus"}
      }
    },
    "completionEvidenceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_contracts",
        "rustc_version",
        "cargo_version",
        "format",
        "clippy",
        "tests",
        "blackbox",
        "release_build",
        "os_faults",
        "oci",
        "deep",
        "supply",
        "formal_soak",
        "formal_soak_validation",
        "traceability"
      ],
      "properties": {
        "public_contracts": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "rustc_version": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "cargo_version": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "format": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "clippy": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "tests": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "blackbox": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "release_build": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "os_faults": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "oci": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "deep": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "supply": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "formal_soak": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "formal_soak_validation": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "traceability": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "completeCompletionEvidenceDigests": {
      "allOf": [
        {"$ref": "#/$defs/completionEvidenceDigests"},
        {"additionalProperties": {"$ref": "#/$defs/sha256"}}
      ]
    },
    "moduleCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "status",
        "known_p0_count",
        "real_startup_test_blocker_count",
        "findings_registry",
        "findings_registry_digest",
        "blockers",
        "criteria",
        "evidence_digests"
      ],
      "properties": {
        "decision_id": {"const": "DEC-044"},
        "status": {"enum": ["COMPLETE", "INCOMPLETE"]},
        "known_p0_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "real_startup_test_blocker_count": {"type": "integer", "minimum": 0, "maximum": 11},
        "findings_registry": {"const": "edge-rs/module-findings.json"},
        "findings_registry_digest": {"$ref": "#/$defs/sha256"},
        "blockers": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public_contracts",
              "format_lint_static",
              "unit_property_contract",
              "release_binary",
              "real_binary_public_boundary",
              "os_fault_recovery",
              "real_oci_startup",
              "deep_runtime_checks",
              "supply_security_checks",
              "formal_soak",
              "traceability",
              "known_p0_zero"
            ]
          }
        },
        "criteria": {"$ref": "#/$defs/completionCriteria"},
        "evidence_digests": {"$ref": "#/$defs/completionEvidenceDigests"}
      }
    },
    "completeModuleCompletion": {
      "allOf": [
        {"$ref": "#/$defs/moduleCompletion"},
        {
          "properties": {
            "status": {"const": "COMPLETE"},
            "known_p0_count": {"const": 0},
            "real_startup_test_blocker_count": {"const": 0},
            "blockers": {"maxItems": 0},
            "criteria": {"additionalProperties": {"const": "PASS"}},
            "evidence_digests": {"$ref": "#/$defs/completeCompletionEvidenceDigests"}
          }
        }
      ]
    },
    "deepArtifactDigests": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "propertyNames": {
        "enum": [
          "cargo_lock",
          "edge_contract",
          "qualification_profile",
          "miri_log",
          "address_sanitizer_log",
          "thread_sanitizer_log"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "ociChecks": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "propertyNames": {
        "enum": [
          "image_source_labels",
          "single_linux_amd64_image_archive",
          "archive_content_addressing",
          "non_root_user",
          "read_only_rootfs",
          "capability_drop_all",
          "no_new_privileges",
          "bounded_pids_memory_cpu_tmpfs",
          "public_mtls_probe",
          "graceful_sigterm"
        ]
      },
      "additionalProperties": {"const": "PASS"}
    },
    "deepChecks": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "propertyNames": {"enum": ["miri_disable_isolation", "address_sanitizer", "thread_sanitizer"]},
      "additionalProperties": {"const": "PASS"}
    },
    "trueInventoryChecks": {
      "type": "object",
      "minProperties": 9,
      "maxProperties": 9,
