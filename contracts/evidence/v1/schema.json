{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/v1/schema.json",
  "title": "MASI Qualification Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module",
    "run_id",
    "source_revision",
    "source_tree_digest",
    "working_tree_dirty",
    "working_tree_status_digest",
    "started_at",
    "finished_at",
    "level",
    "applicability",
    "result",
    "qualification",
    "claim_scope",
    "environment",
    "phase_bindings",
    "cleanup",
    "tests",
    "performance",
    "remaining_holds",
    "findings",
    "completion",
    "overall_module_complete"
  ],
  "properties": {
    "schema_version": {"const": "qualification-evidence/v1"},
    "module": {"const": "p4-switch"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_revision": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "source_tree_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "working_tree_dirty": {"type": "boolean"},
    "working_tree_status_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "level": {"enum": ["REHEARSAL", "MODULE", "PAIRWISE", "SYSTEM_E2E", "PRODUCTION"]},
    "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
    "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "target_profile",
        "runtime_profile",
        "availability_profile",
        "deployment_tier",
        "topology_profile",
        "environment_profile_digest",
        "runtime_digest",
        "program_digest",
        "p4info_digest",
        "device_config_digest",
        "config_digest",
        "contract_set_digest"
      ],
      "properties": {
        "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_profile": {"const": "p4-stateless-firewall/v1"},
        "runtime_profile": {"const": "simple-switch-grpc-v1model/v1"},
        "availability_profile": {"const": "availability-single/v1"},
        "deployment_tier": {"const": "acceptance"},
        "topology_profile": {"const": "p4-traffic-replay-bmv2-compose/v1"},
        "environment_profile_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "runtime_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "program_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "p4info_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "device_config_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "config_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "contract_set_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
      }
    },
    "environment": {"type": "object", "minProperties": 1},
    "phase_bindings": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "run_id", "source_revision", "source_tree_digest", "working_tree_dirty", "working_tree_status_digest", "document_digest"],
        "properties": {
          "phase": {"enum": ["unit", "runner-environment", "compiler", "p4testgen", "mininet", "functional", "performance", "crash-orchestration", "crash-recovery", "lifecycle", "soak", "supply-chain"]},
          "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source_revision": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
          "source_tree_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
          "working_tree_dirty": {"type": "boolean"},
          "working_tree_status_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
          "document_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "source_revision", "source_tree_digest", "working_tree_dirty", "working_tree_status_digest", "finished_at", "attempted", "result", "qualification", "commands", "remaining_resources", "host_checks", "query_error", "host_error"],
      "properties": {
        "schema_version": {"const": "p4-global-cleanup/v1"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_revision": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
        "source_tree_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "working_tree_dirty": {"type": "boolean"},
        "working_tree_status_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
        "finished_at": {"type": "string", "format": "date-time"},
        "attempted": {"type": "boolean"},
        "result": {"enum": ["PASS", "FAIL"]},
        "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
        "commands": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_code", "output", "timed_out"],
            "properties": {
              "command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 4096}},
              "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
              "output": {"type": "string", "maxLength": 4096},
              "timed_out": {"type": "boolean"}
            }
          }
        },
        "remaining_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["containers", "networks", "volumes"],
          "properties": {
            "containers": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
            "networks": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
            "volumes": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
          }
        },
        "host_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mininet_phase_cleanup_valid", "mininet_host_processes_absent", "mininet_switch_interfaces_absent", "host_interface_masi_s1_absent", "host_interface_masi_s2_absent"],
          "properties": {
            "mininet_phase_cleanup_valid": {"type": "boolean"},
            "mininet_host_processes_absent": {"type": "boolean"},
            "mininet_switch_interfaces_absent": {"type": "boolean"},
            "host_interface_masi_s1_absent": {"type": "boolean"},
            "host_interface_masi_s2_absent": {"type": "boolean"}
          }
        },
        "query_error": {"type": "string", "maxLength": 1024},
        "host_error": {"type": "string", "maxLength": 1024}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
          "then": {
            "properties": {
              "qualification": {"const": "QUALIFIED"},
              "attempted": {"const": true},
              "query_error": {"const": ""},
              "host_error": {"const": ""},
              "host_checks": {
                "properties": {
                  "mininet_phase_cleanup_valid": {"const": true},
                  "mininet_host_processes_absent": {"const": true},
                  "mininet_switch_interfaces_absent": {"const": true},
                  "host_interface_masi_s1_absent": {"const": true},
                  "host_interface_masi_s2_absent": {"const": true}
                }
              }
            }
          },
          "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
        }
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_ids", "level", "applicability", "result", "qualification", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}
          },
          "level": {"enum": ["REHEARSAL", "MODULE", "PAIRWISE", "SYSTEM_E2E", "PRODUCTION"]},
          "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
          "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
          "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
          "duration_ms": {"type": "number", "minimum": 0},
          "evidence": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
            "then": {"properties": {"qualification": {"const": "QUALIFIED"}}},
            "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
          }
        ]
      }
    },
    "performance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_count", "write_ms", "readback_ms", "selector_flip_ms", "packet_oracle_pps", "result", "qualification"],
        "properties": {
          "rule_count": {"enum": [0, 128, 1024, 4096]},
          "write_ms": {"type": "number", "minimum": 0},
          "readback_ms": {"type": "number", "minimum": 0},
          "selector_flip_ms": {"type": "number", "minimum": 0},
          "packet_oracle_pps": {"type": "number", "minimum": 0},
          "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
          "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
            "then": {"properties": {"qualification": {"const": "QUALIFIED"}}},
            "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
          }
        ]
      }
    },
    "remaining_holds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_total", "open_p0", "registry_digest"],
      "properties": {
        "open_total": {"type": "integer", "minimum": 0, "maximum": 4096},
        "open_p0": {"type": "integer", "minimum": 0, "maximum": 4096},
        "registry_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts_frozen",
        "mandatory_tests_executed",
        "formal_soak_executed",
        "no_required_not_run",
        "open_p0_zero",
        "operational_gates_pass",
        "real_runtime_started"
      ],
      "properties": {
        "contracts_frozen": {"type": "boolean"},
        "mandatory_tests_executed": {"type": "boolean"},
        "formal_soak_executed": {"type": "boolean"},
        "no_required_not_run": {"type": "boolean"},
        "open_p0_zero": {"type": "boolean"},
        "operational_gates_pass": {"type": "boolean"},
        "real_runtime_started": {"type": "boolean"}
      }
    },
    "overall_module_complete": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"overall_module_complete": {"const": true}},
        "required": ["overall_module_complete"]
      },
      "then": {
        "properties": {
          "findings": {"properties": {"open_p0": {"const": 0}}},
          "completion": {
            "properties": {
              "contracts_frozen": {"const": true},
              "mandatory_tests_executed": {"const": true},
              "formal_soak_executed": {"const": true},
              "no_required_not_run": {"const": true},
              "open_p0_zero": {"const": true},
              "operational_gates_pass": {"const": true},
              "real_runtime_started": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"result": {"const": "PASS"}},
        "required": ["result"]
      },
      "then": {
        "properties": {
          "overall_module_complete": {"const": true},
          "qualification": {"const": "QUALIFIED"}
        }
      },
      "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
    }
  ]
}
