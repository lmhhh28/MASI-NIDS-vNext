{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/v1/inference-module-schema.json",
  "title": "Central Inference module evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "requirement_ids",
    "level",
    "applicability",
    "result",
    "qualification",
    "source_revision",
    "source_tree_digest",
    "working_tree_dirty",
    "overall_module_complete"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "central-inference-oci-startup-evidence/v1",
        "central-inference-deep-check-evidence/v1",
        "central-inference-supply-verification/v1",
        "central-inference-module-gate-summary/v1"
      ]
    },
    "test_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"}
    },
    "level": {"const": "MODULE"},
    "applicability": {"const": "APPLICABLE"},
    "result": {"enum": ["PASS", "HOLD", "FAIL", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "working_tree_dirty": {"type": "boolean"},
    "working_tree_status_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "overall_module_complete": {"type": "boolean"},
    "module_id": {"const": "MOD-INF-001"},
    "runtime_profile": {"enum": ["model-runtime-central-cpu/v1", "model-runtime-central-cuda/v1"]},
    "availability_profile": {"enum": ["availability-single/v1", "availability-ha/v1"]},
    "deployment_tier": {"enum": ["acceptance", "production", "production-ha"]},
    "completion": {"type": "object"},
    "executed_gates": {"type": "object"},
    "qualification_gates": {"type": "object"},
    "conditional_applicability": {"type": "array", "items": {"type": "object"}},
    "artifact_digests": {"type": "object"},
    "requirement_traceability": {"type": "object"},
    "findings_registry": {"type": "string", "minLength": 1, "maxLength": 256},
    "findings_registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}