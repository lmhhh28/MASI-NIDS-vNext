{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/analysis-image-build/v1/schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "module_id", "level", "applicability", "result", "qualification", "source_revision", "source_tree_digest", "working_tree_status_digest", "working_tree_dirty", "image_ref", "image_id", "image_user", "python_builder_image_digest", "runtime_base_image_digest", "runtime_library_digests", "runtime_versions", "wheelhouse_digest", "lock_digest", "offline_image_build", "runtime_download"],
  "properties": {
    "schema_version": {"const": "analysis-release-build-evidence/v1"}, "module_id": {"const": "MOD-AGENT-001"}, "level": {"const": "MODULE"}, "applicability": {"const": "APPLICABLE"}, "result": {"const": "PASS"}, "qualification": {"const": "NOT_QUALIFIED"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "source_tree_digest": {"$ref": "#/$defs/digest"}, "working_tree_status_digest": {"$ref": "#/$defs/digest"}, "working_tree_dirty": {"type": "boolean"},
    "image_ref": {"type": "string", "minLength": 1, "maxLength": 256}, "image_id": {"$ref": "#/$defs/digest"}, "image_user": {"const": "65532:65532"}, "python_builder_image_digest": {"$ref": "#/$defs/digest"}, "runtime_base_image_digest": {"$ref": "#/$defs/digest"},
    "runtime_library_digests": {"type": "object", "additionalProperties": false, "required": ["libcrypto", "libssl"], "properties": {"libcrypto": {"$ref": "#/$defs/digest"}, "libssl": {"$ref": "#/$defs/digest"}}},
    "runtime_versions": {"type": "object", "additionalProperties": false, "required": ["python", "openssl", "sqlite", "zlib"], "properties": {"python": {"const": "3.12.13"}, "openssl": {"const": "OpenSSL 3.0.20 7 Apr 2026"}, "sqlite": {"const": "3.53.4"}, "zlib": {"const": "1.3.2"}}},
    "wheelhouse_digest": {"$ref": "#/$defs/digest"}, "lock_digest": {"$ref": "#/$defs/digest"}, "offline_image_build": {"const": true}, "runtime_download": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}}
}
