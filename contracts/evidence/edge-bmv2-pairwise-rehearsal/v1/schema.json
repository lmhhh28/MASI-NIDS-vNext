{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/edge-bmv2-pairwise-rehearsal/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "started_at", "finished_at", "participants", "pipeline_loader", "real_boundaries", "fixtures", "traffic", "edge_evidence", "process_logs", "level", "applicability", "result", "qualification", "qualification_scope"],
  "properties": {
    "schema_version": {"const": "edge-bmv2-pairwise-rehearsal/v1"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "participants": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_binary_digest", "bmv2_image_digest", "p4_source_digest", "bmv2_json_digest"],
      "properties": {
        "edge_binary_digest": {"$ref": "#/$defs/digest"}, "bmv2_image_digest": {"$ref": "#/$defs/digest"},
        "p4_source_digest": {"$ref": "#/$defs/digest"}, "bmv2_json_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "pipeline_loader": {"type": "object", "required": ["schema_version", "loader_closed_before_edge", "p4runtime_api_version", "p4info_digest", "device_config_digest", "profile_digest", "cookie"], "properties": {"loader_closed_before_edge": {"const": true}}},
    "real_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_p4runtime_mtls", "edge_streamchannel_mastership", "edge_pipeline_exact_readback", "edge_telemetry_snapshot_wal"],
      "properties": {"edge_p4runtime_mtls": {"const": true}, "edge_streamchannel_mastership": {"const": true}, "edge_pipeline_exact_readback": {"const": true}, "edge_telemetry_snapshot_wal": {"const": true}}
    },
    "fixtures": {"type": "object", "additionalProperties": false, "required": ["pipeline_loader", "traffic_sender", "central_inference", "control_sink"], "properties": {"pipeline_loader": {"const": "isolated-one-shot-closed-before-edge"}, "traffic_sender": {"const": "packet-only-no-p4runtime-credentials"}, "central_inference": {"const": "deterministic-mtls-fake"}, "control_sink": {"const": "deterministic-mtls-fake"}}},
    "traffic": {"type": "object", "required": ["schema_version", "packet_count", "peer_packet_count", "p4runtime_credentials_present"], "properties": {"schema_version": {"const": "bmv2-traffic-sender/v1"}, "packet_count": {"type": "integer", "minimum": 1}, "peer_packet_count": {"type": "integer", "minimum": 64}, "p4runtime_credentials_present": {"const": false}}},
    "edge_evidence": {"type": "object", "required": ["schema_version", "canonical_commit_batches", "fake_p4_stream_opens", "source_wal_bytes_after_traffic", "post_traffic_inference_records", "traffic_observed_packets", "result"], "properties": {"schema_version": {"const": "edge-real-bmv2-pairwise-rehearsal/v1"}, "canonical_commit_batches": {"type": "integer", "minimum": 1}, "fake_p4_stream_opens": {"const": 0}, "source_wal_bytes_after_traffic": {"type": "integer", "minimum": 1}, "post_traffic_inference_records": {"type": "integer", "minimum": 1}, "traffic_observed_packets": {"type": "integer", "minimum": 64}, "result": {"const": "PASS"}}},
    "process_logs": {"type": "object", "additionalProperties": false, "required": ["edge", "bmv2", "compiler", "pipeline_loader", "traffic_sender"], "properties": {"edge": {"$ref": "#/$defs/digest"}, "bmv2": {"$ref": "#/$defs/digest"}, "compiler": {"$ref": "#/$defs/digest"}, "pipeline_loader": {"$ref": "#/$defs/digest"}, "traffic_sender": {"$ref": "#/$defs/digest"}}},
    "level": {"const": "REHEARSAL"}, "applicability": {"const": "APPLICABLE"}, "result": {"const": "PASS"}, "qualification": {"const": "NOT_QUALIFIED"},
    "qualification_scope": {"type": "string", "minLength": 1, "maxLength": 512}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}}
}
