{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/connected-runner-failure/v1/schema.json",
  "title": "Connected rehearsal runner failure evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "runner_id", "run_id", "started_at", "finished_at", "failure_stage",
    "error_type", "participants_started", "cleanup_attempted", "level", "applicability",
    "result", "qualification", "reason_code"
  ],
  "properties": {
    "schema_version": {"const": "connected-runner-failure/v1"},
    "runner_id": {"enum": ["run-edge-central-pairwise"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "failure_stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "error_type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"},
    "participants_started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["central", "edge", "control_postgresql", "p4", "web", "plugin_sideplane", "analysis_sideplane"],
      "properties": {
        "central": {"type": "boolean"}, "edge": {"type": "boolean"},
        "control_postgresql": {"type": "boolean"}, "p4": {"type": "boolean"},
        "web": {"type": "boolean"}, "plugin_sideplane": {"type": "boolean"},
        "analysis_sideplane": {"type": "boolean"}
      }
    },
    "cleanup_attempted": {"const": true},
    "level": {"const": "REHEARSAL"},
    "applicability": {"const": "APPLICABLE"},
    "result": {"const": "FAIL"},
    "qualification": {"const": "NOT_QUALIFIED"},
    "reason_code": {"const": "RUNNER_EXCEPTION"}
  }
}
