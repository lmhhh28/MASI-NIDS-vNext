{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/analysis-module/v1/schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "module_id", "level", "applicability", "qualification", "generated_at", "source_revision", "source_tree_digest", "working_tree_dirty", "working_tree_status_digest", "executed_gates", "completion", "findings", "release_runtime", "blackbox_e2e", "compatibility", "performance", "image_build", "oci", "deployment", "supply_chain", "formal_soak", "traceability", "conditional_applicability", "requirement_ids", "artifact_digests", "qualification_gates", "remaining_holds", "overall_module_complete"],
  "properties": {
    "schema_version": {"const": "analysis-plugin-module-gates/v1"}, "module_id": {"const": "MOD-AGENT-001"}, "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"}, "level": {"const": "MODULE"}, "applicability": {"const": "APPLICABLE"}, "result": {"const": "HOLD"}, "qualification": {"const": "NOT_QUALIFIED"}, "generated_at": {"type": "string", "format": "date-time"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "source_tree_digest": {"$ref": "#/$defs/digest"}, "working_tree_dirty": {"type": "boolean"}, "working_tree_status_digest": {"$ref": "#/$defs/digest"},
    "executed_gates": {"type": "object", "minProperties": 18, "maxProperties": 24, "additionalProperties": {"const": "PASS"}},
    "completion": {"type": "object", "additionalProperties": false, "required": ["formal_soak_executed", "no_required_not_run", "open_p0_zero", "operational_gates_pass", "real_release_process_started", "real_oci_started"], "properties": {"formal_soak_executed": {"const": true}, "no_required_not_run": {"const": true}, "open_p0_zero": {"const": true}, "operational_gates_pass": {"const": true}, "real_release_process_started": {"const": true}, "real_oci_started": {"const": true}}},
    "findings": {"type": "object", "additionalProperties": false, "required": ["open_total", "open_p0"], "properties": {"open_total": {"const": 0}, "open_p0": {"const": 0}}},
    "release_runtime": {"$ref": "#/$defs/evidenceRef"}, "blackbox_e2e": {"$ref": "#/$defs/evidenceRef"}, "compatibility": {"$ref": "#/$defs/evidenceRef"}, "performance": {"$ref": "#/$defs/evidenceRef"}, "image_build": {"$ref": "#/$defs/evidenceRef"}, "oci": {"$ref": "#/$defs/evidenceRef"}, "deployment": {"$ref": "#/$defs/evidenceRef"}, "supply_chain": {"$ref": "#/$defs/evidenceRef"}, "formal_soak": {"$ref": "#/$defs/evidenceRef"}, "traceability": {"$ref": "#/$defs/evidenceRef"},
    "conditional_applicability": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["profile", "applicability", "result", "stable_reason"], "properties": {"profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}/v[0-9]+$"}, "applicability": {"const": "NOT_APPLICABLE"}, "result": {"const": "NOT_RUN"}, "stable_reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{3,63}$"}}}},
    "requirement_ids": {"type": "array", "minItems": 48, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}}, "artifact_digests": {"type": "object", "minProperties": 20, "maxProperties": 128, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "qualification_gates": {"type": "object", "additionalProperties": false, "required": ["formal_soak_3600_seconds", "analysis_boundary_performance", "real_external_provider", "go_analysis_pairwise", "protected_release_baseline", "production_ha_multi_failure_domain", "nine_module_global_gate"], "properties": {"formal_soak_3600_seconds": {"const": "PASS"}, "analysis_boundary_performance": {"const": "PASS"}, "real_external_provider": {"const": "HOLD"}, "go_analysis_pairwise": {"const": "HOLD"}, "protected_release_baseline": {"const": "HOLD"}, "production_ha_multi_failure_domain": {"const": "HOLD"}, "nine_module_global_gate": {"const": "HOLD"}}},
    "remaining_holds": {"type": "array", "minItems": 4, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}, "overall_module_complete": {"const": true}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}, "evidenceRef": {"type": "object", "additionalProperties": false, "required": ["evidence", "digest", "result", "qualification", "run_id", "source_revision", "source_tree_digest", "working_tree_status_digest", "producer_command_id", "producer_command_digest"], "properties": {"evidence": {"type": "string", "minLength": 1, "maxLength": 512}, "digest": {"$ref": "#/$defs/digest"}, "result": {"const": "PASS"}, "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]}, "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "source_tree_digest": {"$ref": "#/$defs/digest"}, "working_tree_status_digest": {"$ref": "#/$defs/digest"}, "producer_command_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "producer_command_digest": {"$ref": "#/$defs/digest"}}}}
}
