{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/postgresql-state-capacity/v1/schema.json",
  "title": "PostgreSQL State exact-schema capacity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "module_id", "level", "applicability", "result", "qualification", "identity", "matrix", "threshold_status"],
  "properties": {
    "schema_version": {"const": "postgresql-state-capacity/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "module_id": {"const": "MOD-DB-001"},
    "level": {"const": "MODULE"},
    "applicability": {"const": "APPLICABLE"},
    "result": {"enum": ["PASS", "FAIL"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["database", "user", "server_version_num", "tls"],
      "properties": {
        "database": {"const": "masi_state_module_test"},
        "user": {"const": "masi_app_login"},
        "server_version_num": {"type": "integer", "minimum": 180000, "maximum": 189999},
        "tls": {"const": true}
      }
    },
    "matrix": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/measurement"}, {"properties": {"rule_count": {"const": 0}}}]},
        {"allOf": [{"$ref": "#/$defs/measurement"}, {"properties": {"rule_count": {"const": 128}}}]},
        {"allOf": [{"$ref": "#/$defs/measurement"}, {"properties": {"rule_count": {"const": 1024}}}]},
        {"allOf": [{"$ref": "#/$defs/measurement"}, {"properties": {"rule_count": {"const": 4096}}}]}
      ],
      "items": false
    },
    "threshold_status": {"const": "OBSERVED_ONLY_OWNER_NOT_FROZEN_DEC_001"}
  },
  "allOf": [{
    "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
    "then": {"properties": {"qualification": {"const": "QUALIFIED"}}}
  }],
  "$defs": {
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_count", "revision_json_rules", "epoch_rows", "observation_rows", "rollup_5m_rows", "rollup_1h_rows", "build_microseconds", "current_query_microseconds", "page_query_microseconds", "trend_query_microseconds", "rolled_back"],
      "properties": {
        "rule_count": {"enum": [0, 128, 1024, 4096]},
        "revision_json_rules": {"type": "integer", "minimum": 0, "maximum": 4096},
        "epoch_rows": {"type": "integer", "minimum": 0, "maximum": 4096},
        "observation_rows": {"type": "integer", "minimum": 0, "maximum": 4096},
        "rollup_5m_rows": {"type": "integer", "minimum": 0, "maximum": 1},
        "rollup_1h_rows": {"type": "integer", "minimum": 0, "maximum": 4096},
        "build_microseconds": {"type": "integer", "minimum": 0},
        "current_query_microseconds": {"type": "integer", "minimum": 0},
        "page_query_microseconds": {"type": "integer", "minimum": 0},
        "trend_query_microseconds": {"type": "integer", "minimum": 0},
        "rolled_back": {"const": true}
      }
    }
  }
}
