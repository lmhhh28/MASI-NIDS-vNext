{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/traceability/v1/schema.json",
  "title": "RustEdgeTraceabilityEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "manifest",
    "manifest_digest",
    "evidence_root",
    "result",
    "qualification",
    "requirements",
    "requirement_ids",
    "conditional_applicability",
    "artifacts",
    "failures",
    "valid"
  ],
  "properties": {
    "schema_version": {"enum": ["rust-edge-agent-traceability-evidence/v1", "central-inference-traceability-evidence/v1"]},
    "module_id": {"enum": ["MOD-EDGE-001", "MOD-INF-001"]},
    "manifest": {"type": "string", "minLength": 1, "maxLength": 4096},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "evidence_root": {"type": ["string", "null"], "maxLength": 4096},
    "result": {"enum": ["PASS", "FAIL"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "requirements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/requirementId"}
    },
    "conditional_applicability": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/conditional"}
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "failures": {
      "type": "array",
      "maxItems": 2048,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "valid": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "valid": {"const": true},
          "failures": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "valid": {"const": false},
          "qualification": {"const": "NOT_QUALIFIED"},
          "failures": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirementId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "command_id", "result", "qualification"],
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 256},
        "command_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
        "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
          "then": {"properties": {"qualification": {"const": "QUALIFIED"}}},
          "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "result", "qualification"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "kind": {"enum": ["execution-log", "json-evidence"]},
        "schema_version": {"type": ["string", "null"], "maxLength": 128},
        "test_id": {"type": ["string", "null"], "maxLength": 128},
        "requirement_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirementId"}
        },
        "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
        "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
        "command_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "command_evidence_path": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}\\.command\\.json$"},
        "command_evidence_digest": {"$ref": "#/$defs/digest"},
        "log_digest": {"$ref": "#/$defs/digest"},
        "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "execution-log"}}, "required": ["kind"]},
          "then": {
            "required": [
              "command_id",
              "command_evidence_path",
              "command_evidence_digest",
              "log_digest",
              "exit_code"
            ]
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "scenario_ids",
        "test_targets",
        "evidence",
        "evidence_result",
        "qualification",
        "qualification_limit"
      ],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/requirementId"},
        "scenario_ids": {"$ref": "#/$defs/stringSet"},
        "test_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/target"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "evidence_result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
        "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
        "qualification_limit": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "conditional": {
      "oneOf": [
        {"const": {"profile": "target-gnmi-readonly/v1", "applicability": "NOT_APPLICABLE", "result": "NOT_RUN", "stable_reason": "NOT_TRIGGERED_BY_FIRST_RELEASE_BMV2_ASSIGNMENT"}},
        {"const": {"profile": "mirror-packet-mmap/v1", "applicability": "NOT_APPLICABLE", "result": "NOT_RUN", "stable_reason": "P4_FEATURES_SUFFICIENT_FOR_SELECTED_MODEL"}},
        {"const": {"profile": "mirror-af-xdp/v1", "applicability": "NOT_APPLICABLE", "result": "NOT_RUN", "stable_reason": "PACKET_MMAP_PROFILE_NOT_TRIGGERED"}},
        {"const": {"profile": "mirror-dpdk/v1", "applicability": "NOT_APPLICABLE", "result": "NOT_RUN", "stable_reason": "AF_XDP_PROFILE_NOT_TRIGGERED"}}
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "media_type": {"enum": ["application/json", "application/x-tar", "text/plain"]}
      }
    }
  }
}
