{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/web-control-pairwise-rehearsal/v1/schema.json",
  "title": "Go Control PostgreSQL to production Web P9 rehearsal V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "source_revision", "source_tree_digest", "working_tree_dirty",
    "working_tree_status_digest", "cleanup", "boundary", "started_at", "finished_at", "participants",
    "real_boundaries", "runs", "failures", "result", "qualification", "qualification_scope"
  ],
  "properties": {
    "schema_version": {"const": "web-control-pairwise-rehearsal/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "source_revision": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "source_tree_digest": {"$ref": "#/$defs/digest"},
    "working_tree_dirty": {"type": "boolean"},
    "working_tree_status_digest": {"$ref": "#/$defs/digest"},
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "attempted", "result", "commands", "remaining_resources"],
      "properties": {
        "schema_version": {"const": "p9-runtime-cleanup/v1"},
        "attempted": {"const": true}, "result": {"const": "PASS"},
        "commands": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "exit_code", "output_tail", "timed_out"],
            "properties": {
              "name": {"enum": ["runtime-containers", "runtime-network", "postgresql-compose"]},
              "exit_code": {"const": 0}, "output_tail": {"type": "string", "maxLength": 2048},
              "timed_out": {"const": false}
            }
          }
        },
        "remaining_resources": {"type": "array", "maxItems": 0}
      }
    },
    "boundary": {"const": "P9_GO_CONTROL_POSTGRESQL_TO_PRODUCTION_WEB"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "participants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgresql", "control_core", "web", "browsers"],
      "properties": {
        "postgresql": {"const": "postgresql-18-test-container"},
        "control_core": {"$ref": "#/$defs/digest"},
        "web": {"$ref": "#/$defs/digest"},
        "browsers": {"const": "@playwright/test@1.62.1 exact three-engine profile"}
      }
    },
    "real_boundaries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["HTTP generated-client projections", "opaque session cookie", "CSRF", "SSE", "PostgreSQL target fact"]}
    },
    "runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["browser", "initial_navigation_attempts", "projections_checked", "csrf_negative_status", "target_registration_observed", "sse_connections_per_tab", "page_errors", "request_failures", "result"],
        "properties": {
          "browser": {"enum": ["chromium", "firefox", "webkit"]},
          "initial_navigation_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "projections_checked": {"const": 25},
          "csrf_negative_status": {"const": 403},
          "target_registration_observed": {"const": true},
          "sse_connections_per_tab": {"const": 1},
          "page_errors": {"type": "array", "maxItems": 0},
          "request_failures": {"type": "array", "maxItems": 0},
          "result": {"const": "PASS"}
        }
      }
    },
    "failures": {"type": "array", "maxItems": 0},
    "result": {"const": "PASS"},
    "qualification": {"const": "NOT_QUALIFIED"},
    "qualification_scope": {"const": "REAL_P9_REHEARSAL_WITH_TEST_PROFILE_PLAINTEXT_TEST_LOGIN; FORMAL_HTTPS_OIDC_PAIRWISE_NOT_CLAIMED"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
  }
}
