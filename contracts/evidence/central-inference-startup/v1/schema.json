{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/central-inference-startup/v1/schema.json",
  "title": "CentralInferenceStartupEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "module",
    "requirement_ids",
    "level",
    "applicability",
    "result",
    "qualification",
    "startup_stages",
    "selected_runtime_profile",
    "observed_providers",
    "repository_closure",
    "instance_group_explicit",
    "loaded_model_readback"
  ],
  "properties": {
    "schema_version": {"const": "central-inference-startup-evidence/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "module": {"const": "MOD-INF-001"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
    },
    "level": {"enum": ["REHEARSAL", "MODULE"]},
    "applicability": {"const": "APPLICABLE"},
    "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "selected_runtime_profile": {"enum": ["model-runtime-central-cpu/v1", "model-runtime-central-cuda/v1"]},
    "observed_providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["CPUExecutionProvider", "CUDAExecutionProvider"]}
    },
    "selected_equals_observed": {"type": "boolean"},
    "wrong_hardware_fail_closed": {"type": "boolean"},
    "provider_partition_drift_rejected": {"type": "boolean"},
    "repository_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "extra_model_rejected", "read_only_mount"],
      "properties": {
        "exact": {"type": "boolean"},
        "extra_model_rejected": {"type": "boolean"},
        "read_only_mount": {"type": "boolean"},
        "closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "instance_group_explicit": {"type": "boolean"},
    "implicit_instance_group_rejected": {"type": "boolean"},
    "loaded_model_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_exact", "digest_match", "loaded_not_current"],
      "properties": {
        "identity_exact": {"type": "boolean"},
        "digest_match": {"type": "boolean"},
        "loaded_not_current": {"type": "boolean"},
        "pool_observation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "startup_stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "started_at", "finished_at", "result"],
        "properties": {
          "name": {"enum": ["read-profile", "probe-hardware", "verify-envelope", "verify-repository", "triton-none-load", "warmup-numeric-self-test", "gateway-readback", "readiness"]},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "result": {"enum": ["PASS", "FAIL"]},
          "duration_ms": {"type": "integer", "minimum": 0}
        }
      }
    },
    "triton_model_control_mode": {"const": "none"},
    "auto_complete_disabled": {"type": "boolean"},
    "strict_readiness": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "qualification": {"const": "QUALIFIED"},
          "selected_equals_observed": {"const": true},
          "wrong_hardware_fail_closed": {"const": true},
          "repository_closure": {"properties": {"exact": {"const": true}, "extra_model_rejected": {"const": true}, "read_only_mount": {"const": true}}},
          "instance_group_explicit": {"const": true},
          "loaded_model_readback": {"properties": {"identity_exact": {"const": true}, "digest_match": {"const": true}, "loaded_not_current": {"const": true}}}
        }
      }
    }
  ]
}