{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/analysis-soak/v1/schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "module_id", "profile_id", "level", "applicability", "result", "qualification", "source_tree_digest", "profile_digest", "claim_scope", "claim_scope_digest", "started_at", "finished_at", "formal", "warmup_seconds", "warmup_elapsed_ms", "warmup_not_counted", "formal_seconds", "qualified_start_monotonic_ns", "qualified_end_monotonic_ns", "qualified_elapsed_ms", "sample_interval_seconds", "phases", "counters", "crash_restart_recovered", "recovered_incomplete_fenced", "resource_samples", "rss_growth_bytes", "fd_growth", "final_queue_depth", "final_in_flight", "binary_digest", "config_digest", "cleanup", "process_exit_code", "checks"],
  "properties": {
    "schema_version": {"const": "analysis-soak-evidence/v1"}, "module_id": {"const": "MOD-AGENT-001"}, "profile_id": {"const": "analysis-soak/v1"}, "level": {"const": "MODULE"}, "applicability": {"const": "APPLICABLE"}, "result": {"const": "PASS"}, "qualification": {"const": "NOT_QUALIFIED"},
    "source_tree_digest": {"$ref": "#/$defs/digest"}, "profile_digest": {"$ref": "#/$defs/digest"}, "claim_scope": {"type": "object", "minProperties": 5, "maxProperties": 8, "additionalProperties": {"type": "string"}}, "claim_scope_digest": {"$ref": "#/$defs/digest"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
    "formal": {"const": true}, "warmup_seconds": {"const": 60}, "warmup_elapsed_ms": {"type": "number", "minimum": 60000}, "warmup_not_counted": {"const": true}, "formal_seconds": {"const": 3600}, "qualified_start_monotonic_ns": {"type": "integer", "minimum": 1}, "qualified_end_monotonic_ns": {"type": "integer", "minimum": 1}, "qualified_elapsed_ms": {"type": "number", "minimum": 3600000}, "sample_interval_seconds": {"const": 10},
    "phases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["phase_id", "required_seconds", "elapsed_ms", "completed_delta", "typed_rejected_delta"], "properties": {"phase_id": {"enum": ["steady", "peak", "saturation", "recovery"]}, "required_seconds": {"const": 900}, "elapsed_ms": {"type": "number", "minimum": 900000}, "completed_delta": {"type": "integer", "minimum": 0}, "typed_rejected_delta": {"type": "integer", "minimum": 0}}}},
    "counters": {"type": "object", "additionalProperties": false, "required": ["completed", "typed_rejected", "failed", "http_error", "unclassified"], "properties": {"completed": {"type": "integer", "minimum": 1}, "typed_rejected": {"type": "integer", "minimum": 1}, "failed": {"type": "integer", "minimum": 0}, "http_error": {"type": "integer", "minimum": 0}, "unclassified": {"const": 0}}},
    "crash_restart_recovered": {"const": true}, "recovered_incomplete_fenced": {"const": true},
    "resource_samples": {"type": "array", "minItems": 100, "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["phase", "elapsed_ms", "rss_bytes", "fd_count", "queue_depth", "in_flight"], "properties": {"phase": {"enum": ["steady", "peak", "saturation", "recovery"]}, "elapsed_ms": {"type": "number", "minimum": 0}, "rss_bytes": {"type": "integer", "minimum": 1}, "fd_count": {"type": "integer", "minimum": 1}, "queue_depth": {"type": "integer", "minimum": 0, "maximum": 16}, "in_flight": {"type": "integer", "minimum": 0, "maximum": 8}}}},
    "rss_growth_bytes": {"type": "integer", "maximum": 67108864}, "fd_growth": {"type": "integer", "maximum": 32}, "final_queue_depth": {"const": 0}, "final_in_flight": {"const": 0}, "binary_digest": {"$ref": "#/$defs/digest"}, "config_digest": {"$ref": "#/$defs/digest"}, "cleanup": {"const": true}, "process_exit_code": {"const": 0}, "checks": {"type": "object", "minProperties": 10, "maxProperties": 10, "additionalProperties": {"const": true}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
