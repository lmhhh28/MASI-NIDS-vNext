{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/offline-ml-deployment/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "level", "applicability", "result", "qualification", "compose_digest", "checks", "health_endpoints"],
  "properties": {
    "schema_version": {"const": "offline-ml-deployment-evidence/v1"},
    "module_id": {"const": "MOD-ML-001"},
    "level": {"const": "MODULE"},
    "applicability": {"const": "APPLICABLE"},
    "result": {"const": "PASS"},
    "qualification": {"const": "NOT_QUALIFIED"},
    "compose_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "checks": {"type": "object", "minProperties": 14, "additionalProperties": {"const": true}},
    "health_endpoints": {"type": "object", "properties": {"applicability": {"const": "NOT_APPLICABLE"}, "result": {"const": "NOT_RUN"}, "stable_reason": {"const": "BOUNDED_OFFLINE_JOB_EXITS_AFTER_ATOMIC_ARTIFACT_PUBLICATION"}}, "required": ["applicability", "result", "stable_reason"]}
  }
}
