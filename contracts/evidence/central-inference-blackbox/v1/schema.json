{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/evidence/central-inference-blackbox/v1/schema.json",
  "title": "CentralInferenceBlackboxEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "requirement_ids",
    "level",
    "applicability",
    "result",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "central-inference-module-e2e-evidence/v1",
        "central-inference-fault-evidence/v1",
        "central-inference-numeric-evidence/v1",
        "central-inference-resource-bound-evidence/v1",
        "central-inference-security-evidence/v1",
        "central-inference-readback-evidence/v1"
      ]
    },
    "test_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
    },
    "level": {"enum": ["REHEARSAL", "MODULE"]},
    "applicability": {"const": "APPLICABLE"},
    "result": {"enum": ["PASS", "FAIL", "HOLD", "NOT_RUN"]},
    "qualification": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "admission_accepted": {"type": "boolean"},
    "admission_rejected": {"type": "boolean"},
    "batch_digest_exact": {"type": "boolean"},
    "batch_digest_stable": {"type": "boolean"},
    "canonical_event_writable": {"type": "boolean"},
    "class_order_correct": {"type": "boolean"},
    "deadline_ms": {"type": "integer", "minimum": 0},
    "duplicate_response_idempotent": {"type": "boolean"},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "eligible_workers_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "explicit_profile_selected": {"type": "boolean"},
    "extra_model_rejected": {"type": "boolean"},
    "fail_closed": {"type": "boolean"},
    "fault": {"type": "string", "maxLength": 256},
    "faults": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
    "full_pool_outage_bounded": {"type": "boolean"},
    "gateway_process": {"type": "string", "maxLength": 128},
    "implicit_instance_group_rejected": {"type": "boolean"},
    "inference_calls": {"type": "integer", "minimum": 0},
    "late_result_fenced": {"type": "boolean"},
    "loaded_not_current": {"type": "boolean"},
    "mtls_verified": {"type": "boolean"},
    "nan_rejected": {"type": "boolean"},
    "inf_rejected": {"type": "boolean"},
    "no_fallback": {"type": "boolean"},
    "numeric_match_python_reference": {"type": "boolean"},
    "ood_handled": {"type": "boolean"},
    "abstain_handled": {"type": "boolean"},
    "oversize_rejected": {"type": "boolean"},
    "plaintext_rejected": {"type": "boolean"},
    "pool_unavailable_returns_stable_error": {"type": "boolean"},
    "provider_available": {"type": "string", "enum": ["CPUExecutionProvider", "CUDAExecutionProvider"]},
    "provider_partition_drift_rejected": {"type": "boolean"},
    "readback_identity_exact": {"type": "boolean"},
    "real_binary": {"type": "boolean"},
    "real_triton": {"type": "boolean"},
    "real_ort": {"type": "boolean"},
    "repository_closure_exact": {"type": "boolean"},
    "request_identity_stable": {"type": "boolean"},
    "result_identity_mismatch_fenced": {"type": "boolean"},
    "result_digest_conflict_fenced": {"type": "boolean"},
    "retry_identity_stable": {"type": "boolean"},
    "same_generation_retry_bounded": {"type": "boolean"},
    "selected_equals_observed": {"type": "boolean"},
    "shutdown_exit_zero": {"type": "boolean"},
    "triton_dynamic_batch": {"type": "boolean"},
    "triton_instance_group_explicit": {"type": "boolean"},
    "triton_model_control_none": {"type": "boolean"},
    "unknown_major_rejected": {"type": "boolean"},
    "wrong_generation_fenced": {"type": "boolean"},
    "wrong_hardware_fail_closed": {"type": "boolean"},
    "overall_module_complete": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {"properties": {"qualification": {"const": "QUALIFIED"}}},
      "else": {"properties": {"qualification": {"const": "NOT_QUALIFIED"}}}
    },
    {
      "if": {"properties": {"level": {"const": "REHEARSAL"}}, "required": ["level"]},
      "then": {
        "properties": {
          "result": {"enum": ["HOLD", "FAIL", "NOT_RUN"]},
          "qualification": {"const": "NOT_QUALIFIED"}
        }
      }
    }
  ]
}