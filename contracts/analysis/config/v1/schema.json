{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/analysis/config/v1/schema.json",
  "title": "Analysis Plugin Runtime Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_profile", "plugin_id", "contract_root", "manifest_path", "binding_path", "store_path", "health_state_path", "listen", "tls", "limits", "mcp", "provider", "a2a_peers", "public_agent_card_url", "config_id"],
  "properties": {
    "schema_version": {"const": "masi-analysis-config/v1"},
    "runtime_profile": {"enum": ["acceptance", "production"]},
    "plugin_id": {"const": "masi.analysis.langgraph"},
    "contract_root": {"$ref": "#/$defs/path"},
    "manifest_path": {"$ref": "#/$defs/path"},
    "binding_path": {"$ref": "#/$defs/path"},
    "store_path": {"$ref": "#/$defs/path"},
    "health_state_path": {"$ref": "#/$defs/path"},
    "listen": {
      "type": "object", "additionalProperties": false, "required": ["host", "port"],
      "properties": {"host": {"type": "string", "minLength": 1, "maxLength": 253}, "port": {"type": "integer", "minimum": 1024, "maximum": 65535}}
    },
    "tls": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "cert_file", "key_file", "client_ca_file", "allowed_client_sans"],
      "properties": {
        "enabled": {"type": "boolean"},
        "cert_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "key_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "client_ca_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "allowed_client_sans": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}}
      }
    },
    "limits": {"$ref": "#/$defs/limits"},
    "mcp": {"$ref": "#/$defs/outbound"},
    "provider": {"$ref": "#/$defs/provider"},
    "a2a_peers": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/peer"}},
    "public_agent_card_url": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 512},
    "config_id": {"$ref": "#/$defs/identity"}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["request_bytes", "response_bytes", "artifact_bytes", "queue_depth", "concurrency", "task_retention_seconds", "max_tasks", "max_trace_events_per_task", "shutdown_grace_ms"],
      "properties": {
        "request_bytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "response_bytes": {"type": "integer", "minimum": 1024, "maximum": 131072},
        "artifact_bytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "queue_depth": {"type": "integer", "minimum": 1, "maximum": 64},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "task_retention_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "max_tasks": {"type": "integer", "minimum": 16, "maximum": 100000},
        "max_trace_events_per_task": {"type": "integer", "minimum": 8, "maximum": 128},
        "shutdown_grace_ms": {"type": "integer", "minimum": 100, "maximum": 30000}
      }
    },
    "outbound": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_digest", "base_url", "origin", "allowed_ips", "server_name", "ca_file", "cert_file", "key_file", "tool_allowlist", "resource_allowlist"],
      "properties": {
        "profile_id": {"const": "masi-mcp-readonly/v1"}, "profile_digest": {"$ref": "#/$defs/digest"},
        "base_url": {"type": "string", "format": "uri", "maxLength": 512}, "origin": {"type": "string", "format": "uri", "maxLength": 512},
        "allowed_ips": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "ipv4"}},
        "server_name": {"type": "string", "minLength": 1, "maxLength": 253},
        "ca_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}, "cert_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}, "key_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "tool_allowlist": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
        "resource_allowlist": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_digest", "provider_id", "model_id", "base_url", "allowed_ips", "server_name", "ca_file", "cert_file", "key_file", "auth_secret_file"],
      "properties": {
        "profile_id": {"const": "analysis-provider/v1"}, "profile_digest": {"$ref": "#/$defs/digest"}, "provider_id": {"$ref": "#/$defs/identity"}, "model_id": {"$ref": "#/$defs/identity"},
        "base_url": {"type": "string", "format": "uri", "maxLength": 512}, "allowed_ips": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "ipv4"}},
        "server_name": {"type": "string", "minLength": 1, "maxLength": 253}, "ca_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}, "cert_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}, "key_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}, "auth_secret_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}
      }
    },
    "peer": {
      "type": "object", "additionalProperties": false,
      "required": ["peer_id", "plugin_id", "binding_generation", "base_url", "allowed_ips", "server_name", "ca_file", "cert_file", "key_file"],
      "properties": {
        "peer_id": {"$ref": "#/$defs/identity"}, "plugin_id": {"$ref": "#/$defs/identity"}, "binding_generation": {"type": "integer", "minimum": 1}, "base_url": {"type": "string", "format": "uri", "maxLength": 512},
        "allowed_ips": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "ipv4"}}, "server_name": {"type": "string", "minLength": 1, "maxLength": 253},
        "ca_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}, "cert_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}, "key_file": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"runtime_profile": {"const": "production"}}, "required": ["runtime_profile"]}, "then": {"properties": {"tls": {"properties": {"enabled": {"const": true}, "cert_file": {"$ref": "#/$defs/path"}, "key_file": {"$ref": "#/$defs/path"}, "client_ca_file": {"$ref": "#/$defs/path"}}}}}}
  ]
}
