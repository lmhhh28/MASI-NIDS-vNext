{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/model/v1/error-semantics.json",
  "title": "MASI Model Contract V1 Stable Error Namespace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "stability_rules",
    "fail_closed_policy"
  ],
  "properties": {
    "schema_version": {"const": "masi-model-error-semantics/v1"},
    "namespace": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "object",
        "additionalProperties": false,
        "required": ["code", "layer", "meaning", "retryable", "recovery"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "layer": {"enum": ["admission", "session-create", "readiness", "runtime", "control", "handshake", "rollout", "repository"]},
          "meaning": {"type": "string", "minLength": 1, "maxLength": 512},
          "retryable": {"enum": ["never", "same-generation-bounded", "new-operation"]},
          "recovery": {"enum": ["none", "edge-bounded-retry", "new-durable-operation", "admin-explicit-rollback", "quarantine"]}
        }
      }
    },
    "stability_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codes_immutable", "addition_requires_new_minor", "removal_requires_new_major", "mapping_stable_across_languages"],
      "properties": {
        "codes_immutable": {"type": "boolean", "const": true},
        "addition_requires_new_minor": {"type": "boolean", "const": true},
        "removal_requires_new_major": {"type": "boolean", "const": true},
        "mapping_stable_across_languages": {"type": "boolean", "const": true}
      }
    },
    "fail_closed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "no_fallback", "no_automatic_profile_switch", "no_automatic_model_switch"],
      "properties": {
        "default": {"const": "HOLD-stale-or-unavailable"},
        "no_fallback": {"type": "boolean", "const": true},
        "no_automatic_profile_switch": {"type": "boolean", "const": true},
        "no_automatic_model_switch": {"type": "boolean", "const": true}
      }
    }
  }
}