{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masi-nids.example/contracts/target/v1/schema.json",
  "title": "Stable Target Assignment V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_id",
    "device_id",
    "role",
    "p4runtime_endpoint",
    "p4runtime_tls",
    "fence",
    "lease_id",
    "issued_at_unix_ms",
    "expires_at_unix_ms",
    "election_floor",
    "election_ceiling",
    "expected_pipeline",
    "observation_epoch",
    "reset_epoch",
    "trace_id"
  ],
  "properties": {
    "schema_version": {"const": "target-assignment/v1"},
    "target_id": {"$ref": "#/$defs/identity"},
    "device_id": {"type": "integer", "minimum": 1},
    "role": {"const": "primary"},
    "p4runtime_endpoint": {
      "type": "string",
      "minLength": 12,
      "maxLength": 512,
      "pattern": "^https://[^/?#]+:[0-9]{1,5}$"
    },
    "p4runtime_tls": {"$ref": "#/$defs/tls_identity"},
    "fence": {"$ref": "#/$defs/fence"},
    "lease_id": {"$ref": "#/$defs/identity"},
    "issued_at_unix_ms": {"type": "integer", "minimum": 1},
    "expires_at_unix_ms": {"type": "integer", "minimum": 1},
    "election_floor": {"type": "integer", "minimum": 1},
    "election_ceiling": {"type": "integer", "minimum": 1},
    "expected_pipeline": {"$ref": "#/$defs/pipeline_identity"},
    "observation_epoch": {"type": "integer", "minimum": 1},
    "reset_epoch": {"type": "integer", "minimum": 1},
    "trace_id": {"$ref": "#/$defs/identity"}
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "tls_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_name", "identity_ref"],
      "properties": {
        "server_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?!\\*)(?![0-9.]+$)[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
        },
        "identity_ref": {"$ref": "#/$defs/identity"}
      }
    },
    "fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_control_incarnation_id",
        "target_assignment_generation",
        "actor_runtime_epoch",
        "application_generation",
        "election_id_high",
        "election_id_low"
      ],
      "properties": {
        "target_control_incarnation_id": {"$ref": "#/$defs/identity"},
        "target_assignment_generation": {"type": "integer", "minimum": 1},
        "actor_runtime_epoch": {"type": "string", "maxLength": 128},
        "application_generation": {"type": "integer", "minimum": 1},
        "election_id_high": {"type": "integer", "minimum": 0},
        "election_id_low": {"type": "integer", "minimum": 1}
      }
    },
    "pipeline_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p4runtime_api_version",
        "p4info_digest",
        "device_config_digest",
        "profile_digest",
        "cookie",
        "supported_write_atomicity"
      ],
      "properties": {
        "p4runtime_api_version": {"const": "1.4.1"},
        "p4info_digest": {"$ref": "#/$defs/digest"},
        "device_config_digest": {"$ref": "#/$defs/digest"},
        "profile_digest": {"$ref": "#/$defs/digest"},
        "cookie": {"type": "integer", "minimum": 1},
        "supported_write_atomicity": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{"const": "CONTINUE_ON_ERROR"}],
          "items": false
        }
      }
    }
  },
  "x-masi-semantic-constraints": [
    {"constraint_id": "TARGET-LEASE-MONOTONIC", "left": "/expires_at_unix_ms", "operator": "gt", "right": "/issued_at_unix_ms"},
    {"constraint_id": "TARGET-ELECTION-RANGE", "left": "/election_ceiling", "operator": "gte", "right": "/election_floor"},
    {"constraint_id": "TARGET-ELECTION-IN-RANGE", "left": "/fence/election_id_low", "operator": "between-inclusive", "right": ["/election_floor", "/election_ceiling"]},
    {"constraint_id": "TARGET-LEASE-NONREUSE", "scope": ["/fence/target_control_incarnation_id", "/target_id"], "operator": "append-only-unique", "field": "/lease_id"},
    {"constraint_id": "TARGET-HANDOFF-ELECTION-FLOOR", "scope": ["/target_id"], "operator": "strictly-above-prior-max", "field": "/election_floor", "prior_field": "/election_ceiling"}
  ]
}
