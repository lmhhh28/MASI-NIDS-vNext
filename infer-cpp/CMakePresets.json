{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 22, "patch": 0},
  "configurePresets": [
    {
      "name": "cpu-release",
      "displayName": "CPU Release (C++20)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cpu-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MASI_INF_OFFLINE": "OFF",
        "MASI_INF_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU Debug (C++20)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cpu-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MASI_INF_OFFLINE": "OFF",
        "MASI_INF_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "cpu-asan",
      "displayName": "CPU Debug + ASan/UBSan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cpu-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MASI_INF_OFFLINE": "OFF",
        "MASI_INF_BUILD_TESTS": "ON",
        "MASI_INF_ENABLE_ASAN": "ON",
        "MASI_INF_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "cpu-tsan",
      "displayName": "CPU Debug + TSan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cpu-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MASI_INF_OFFLINE": "OFF",
        "MASI_INF_BUILD_TESTS": "ON",
        "MASI_INF_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "cpu-release", "configurePreset": "cpu-release"},
    {"name": "cpu-debug", "configurePreset": "cpu-debug"},
    {"name": "cpu-asan", "configurePreset": "cpu-asan"},
    {"name": "cpu-tsan", "configurePreset": "cpu-tsan"}
  ]
}